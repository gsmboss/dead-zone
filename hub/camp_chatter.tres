[gd_resource type="Resource" script_class="CampChatter" format=3]

[ext_resource type="Script" path="res://hub/camp_chatter.gd" id="1_chat"]

[resource]
script = ExtResource("1_chat")
dialogues_ru = Array[PackedStringArray]([PackedStringArray("Как думаешь, зомби тоже мёрзнут?", "Не знаю. Но к костру они бы точно подошли.", "Вот поэтому мы и сидим с ружьём."), PackedStringArray("Я вчера видел зомби в галстуке.", "Наверное, на работу опаздывал.", "Апокалипсис — не повод прогуливать."), PackedStringArray("Сколько дней мы уже здесь?", "Я считал по банкам тушёнки.", "И сколько?", "Сорок две банки. Значит, примерно неделя."), PackedStringArray("Слышал? Что-то скребётся за стеной.", "Это енот.", "Енот в противогазе?", "Ну, енот тоже хочет выжить."), PackedStringArray("Если выберемся, я открою кофейню.", "Назовёшь её «Последняя капля»?", "Нет. «Мозги и печеньки».", "…Я больше туда не пойду."), PackedStringArray("Наш герой опять ушёл на вылазку.", "Надеюсь, принесёт батарейки.", "А я надеюсь, что он вернётся с руками."), PackedStringArray("Ты чего такой бледный?", "Я всегда такой.", "Точно? А ну покажи язык.", "Ааа… доволен?"), PackedStringArray("Раньше я боялся пауков.", "А сейчас?", "Сейчас пауки боятся нас. Мы пахнем хуже."), PackedStringArray("Я научил собаку приносить патроны.", "У нас нет собаки.", "Ну вот поэтому патронов и мало."), PackedStringArray("Говорят, в городе ещё работает автомат с газировкой.", "Это ловушка.", "Это газировка.", "…Ладно, это аргумент."), PackedStringArray("Кто съел мою последнюю шоколадку?", "Зомби.", "Зомби не едят шоколад.", "Этот был особенный."), PackedStringArray("Как думаешь, интернет когда-нибудь вернётся?", "Надеюсь. Я не досмотрел сериал.", "А я не дочитал инструкцию к огнемёту."), PackedStringArray("А ты знал, что у осьминога три сердца?", "Везёт. Ему можно разбить сердце дважды.", "Трижды.", "Тем более."), PackedStringArray("Мёд никогда не портится. Ему могут быть тысячи лет.", "Значит, мой мёд с прошлого года ещё годится?", "Если ты его найдёшь.", "Его съел енот."), PackedStringArray("Как найти север без компаса?", "Ночью — по Полярной звезде.", "А днём?", "Днём спроси у того, у кого есть компас."), PackedStringArray("Воду из реки не пей, пока не прокипятишь.", "Даже если очень хочется?", "Особенно если очень хочется.", "Понял. Ставлю чайник."), PackedStringArray("Наш герой вчера дрифтовал на площади.", "Видел. Пять зомби за один разворот.", "Это называется дрифт-страйк.", "Это называется «мне теперь мыть машину»."), PackedStringArray("Банан — это ягода. А клубника — нет.", "Ты сейчас меня обманываешь.", "Ботаника не врёт.", "Тогда я больше не доверяю клубнике."), PackedStringArray("Почему зомби так любят мозги?", "Мозг тратит пятую часть энергии тела. Самое питательное.", "То есть они на диете?", "На очень странной диете."), PackedStringArray("Я купил в автосалоне спорткар.", "Класса А?", "Класса «на сколько хватило».", "Значит, класс D.", "Не порти момент."), PackedStringArray("Знаешь, сколько можно прожить без воды?", "Около трёх дней.", "А без кофе?", "Одно утро. Максимум одно утро."), PackedStringArray("Ночью звёзды такие яркие.", "Фонари не горят — вот и видно.", "Апокалипсис вернул нам небо.", "И забрал доставку пиццы. Сомнительная сделка."), PackedStringArray("Молния горячее поверхности Солнца в пять раз.", "Откуда ты это знаешь?", "Нашёл книгу в библиотеке.", "А я там нашёл зомби-библиотекаря. Он на меня шикал."), PackedStringArray("Если поранишься — прижми рану чистой тканью и держи.", "Сколько держать?", "Минут десять и не подглядывай.", "А если очень любопытно?", "Тогда ещё десять."), PackedStringArray("Нам нужен неон под машину.", "Зачем?", "Чтобы зомби видели, что мы стильные.", "Они увидят, что мы вкусные и стильные."), PackedStringArray("Ленивец слезает с дерева раз в неделю.", "Зачем?", "В туалет.", "Вот это я понимаю — режим дня."), PackedStringArray("Огню нужны три вещи: топливо, воздух и жар.", "А мне — тушёнка, сон и чтобы никто не кусался.", "Тоже треугольник.", "Треугольник счастья."), PackedStringArray("На Венере солнце встаёт на западе.", "Давай переедем на Венеру.", "Там больше четырёхсот градусов жары.", "Зато нет зомби.", "Там вообще никого нет."), PackedStringArray("Видел, как наш герой стреляет из AWM?", "В голову, с трёхсот метров.", "Я так в мусорку попасть не могу.", "Ты и в дверь не всегда попадаешь."), PackedStringArray("Звук в воде идёт в четыре раза быстрее, чем в воздухе.", "Значит, под водой зомби услышат нас раньше?", "Зомби не умеют плавать.", "Пока что."), PackedStringArray("Когда всё кончится, я стану гонщиком.", "Ты и сейчас гонщик. Убегаешь от зомби.", "Это не считается.", "Считается, если быстро."), PackedStringArray("Пчёлы танцуют, чтобы показать друг другу, где цветы.", "А я танцую, чтобы показать, где тушёнка.", "Никто не понимает твой танец.", "Поэтому вся тушёнка моя."), PackedStringArray("Эйфелева башня летом выше на пятнадцать сантиметров.", "Металл от жары расширяется?", "Именно.", "Значит, я летом тоже больше. Это не я поправился."), PackedStringArray("Если заблудишься — иди вниз по течению ручья.", "Почему?", "Вода приводит к людям.", "А люди — к зомби. Сложная география."), PackedStringArray("Фламинго розовые из-за того, что едят.", "Тогда я должен быть цвета тушёнки.", "Ты и так цвета тушёнки.", "Обидно, но справедливо."), PackedStringArray("Как думаешь, мы выберемся?", "У нас есть костёр, машины и герой с дробовиком.", "И шутки.", "Шутки — наше главное оружие.")])
dialogues_en = Array[PackedStringArray]([PackedStringArray("Do you think zombies get cold too?", "No idea. But they'd love this campfire.", "That's why we sit here with a shotgun."), PackedStringArray("I saw a zombie wearing a tie yesterday.", "Probably late for work.", "The apocalypse is no excuse to skip the office."), PackedStringArray("How many days have we been here?", "I count them in cans of beans.", "And?", "Forty two cans. So, about a week."), PackedStringArray("Did you hear that? Something is scratching the wall.", "It's a raccoon.", "A raccoon in a gas mask?", "Hey, raccoons want to survive too."), PackedStringArray("If we make it, I'm opening a coffee shop.", "Calling it The Last Drop?", "No. Brains and Cookies.", "I'm never going there."), PackedStringArray("Our hero went out on another run.", "Hope they bring back batteries.", "I just hope they come back with both arms."), PackedStringArray("Why are you so pale?", "I've always been like this.", "Are you sure? Show me your tongue.", "Aaah. Happy now?"), PackedStringArray("I used to be scared of spiders.", "And now?", "Now spiders are scared of us. We smell worse."), PackedStringArray("I taught the dog to fetch ammo.", "We don't have a dog.", "Well, that's why we're low on ammo."), PackedStringArray("They say a soda machine still works downtown.", "It's a trap.", "It's soda.", "Okay, fair point."), PackedStringArray("Who ate my last chocolate bar?", "A zombie.", "Zombies don't eat chocolate.", "This one was special."), PackedStringArray("Do you think the internet will ever come back?", "I hope so. I never finished my show.", "I never finished the flamethrower manual."), PackedStringArray("Did you know an octopus has three hearts?", "Lucky. It can get its heart broken twice.", "Three times.", "Even better."), PackedStringArray("Honey never spoils. It can be thousands of years old.", "So my honey from last year is still good?", "If you can find it.", "The raccoon ate it."), PackedStringArray("How do you find north without a compass?", "At night, by the North Star.", "And during the day?", "Ask someone who has a compass."), PackedStringArray("Never drink river water before you boil it.", "Even if I'm really thirsty?", "Especially then.", "Got it. Putting the kettle on."), PackedStringArray("Our hero was drifting on the square yesterday.", "I saw. Five zombies in one spin.", "That's called a drift strike.", "That's called now I have to wash the car."), PackedStringArray("A banana is a berry. A strawberry isn't.", "You're lying to me.", "Botany doesn't lie.", "Then I no longer trust strawberries."), PackedStringArray("Why do zombies love brains so much?", "The brain burns a fifth of the body's energy. Most nutritious part.", "So they're on a diet?", "A very strange diet."), PackedStringArray("I bought a sports car at the dealership.", "Class A?", "Class whatever-I-could-afford.", "So, class D.", "Don't ruin the moment."), PackedStringArray("Know how long you can live without water?", "About three days.", "And without coffee?", "One morning. One morning max."), PackedStringArray("The stars are so bright at night.", "No streetlights anymore, that's why.", "The apocalypse gave us back the sky.", "And took away pizza delivery. Questionable deal."), PackedStringArray("Lightning is five times hotter than the surface of the Sun.", "How do you know that?", "Found a book in the library.", "I found a zombie librarian there. He shushed me."), PackedStringArray("If you get cut, press a clean cloth on the wound and hold it.", "For how long?", "Ten minutes, no peeking.", "What if I'm really curious?", "Then another ten."), PackedStringArray("We need neon under the car.", "Why?", "So the zombies know we've got style.", "They'll know we're tasty and stylish."), PackedStringArray("A sloth climbs down from its tree once a week.", "Why?", "To go to the toilet.", "Now that's a daily routine."), PackedStringArray("Fire needs three things: fuel, air and heat.", "I need stew, sleep and nobody biting me.", "Also a triangle.", "The triangle of happiness."), PackedStringArray("On Venus, the sun rises in the west.", "Let's move to Venus.", "It's over four hundred degrees there.", "But no zombies.", "There's nobody there at all."), PackedStringArray("Did you see our hero with the AWM?", "Headshot, three hundred metres.", "I can't even hit the trash can.", "You can't always hit the door either."), PackedStringArray("Sound travels four times faster in water than in air.", "So underwater zombies would hear us sooner?", "Zombies can't swim.", "Yet."), PackedStringArray("When this is over, I'll become a racer.", "You already are. You race away from zombies.", "That doesn't count.", "It counts if you're fast."), PackedStringArray("Bees dance to show each other where the flowers are.", "I dance to show where the canned stew is.", "Nobody understands your dance.", "That's why all the stew is mine."), PackedStringArray("The Eiffel Tower is fifteen centimetres taller in summer.", "Metal expands in the heat?", "Exactly.", "So I'm bigger in summer too. I didn't gain weight."), PackedStringArray("If you get lost, follow a stream downhill.", "Why?", "Water leads to people.", "And people lead to zombies. Tricky geography."), PackedStringArray("Flamingos are pink because of what they eat.", "Then I should be the colour of canned stew.", "You already are.", "Rude, but fair."), PackedStringArray("Do you think we'll make it?", "We have a fire, cars and a hero with a shotgun.", "And jokes.", "Jokes are our most important weapon.")])
solo_ru = PackedStringArray("Тишина… Не люблю тишину.", "Надо бы почистить ружьё. Завтра. Или послезавтра.", "Эх, сейчас бы горячий душ.", "Интересно, а зомби снятся сны?", "Огонь горит. Значит, мы ещё живы.", "Шины по углам площади — гениально. Сам придумал.", "Где-то тут был ключ от бронегрузовика…", "Звёзды сегодня как в планетарии.")
solo_en = PackedStringArray("Quiet... I hate quiet.", "I should clean my rifle. Tomorrow. Or the day after.", "Oh, for a hot shower right now.", "I wonder if zombies dream.", "The fire is still burning. So are we.", "Tyres on the corners of the square. Genius. My idea.", "The armored truck key was around here somewhere...", "The stars tonight look like a planetarium.")
jokes_ru = Array[PackedStringArray]([PackedStringArray("Почему зомби не ходят в школу? Им и так мозги выносят.", "Ха! Это ты мне сейчас мозг вынес."), PackedStringArray("Зомби приходит к врачу: доктор, я ужасно себя чувствую. А врач: да вы и выглядите не очень.", "Ха, врачи все такие."), PackedStringArray("Я записался на фитнес. Бегаю от зомби по три часа в день.", "Вот это кардио!"), PackedStringArray("Почему зомби такие медленные? Экономят энергию — мозги нынче дорогие.", "Слушай, а ведь логично."), PackedStringArray("Как называют зомби-повара? Шеф-мертвец.", "Ставлю пять звёзд."), PackedStringArray("Тук-тук. Кто там? Зомби. Какой зомби? Который уже внутри.", "Не смешно! Ладно, смешно."), PackedStringArray("Зомби никогда не едят клоунов. Они на вкус смешные.", "Ха-ха! Классика."), PackedStringArray("Две новости: хорошая — интернет вернулся. Плохая — я соврал.", "Зачем ты так со мной?"), PackedStringArray("Я починил машину скотчем. Если не держится — значит, мало скотча.", "Инженер от бога."), PackedStringArray("Почему зомби плохо играют в прятки? Их выдаёт запах.", "А тебя выдают шутки."), PackedStringArray("Апокалипсис — единственное время, когда в городе нет пробок.", "Видишь, есть и плюсы!"), PackedStringArray("Вчера дрифтовал по городу. Зомби аплодировали стоя. По частям.", "Фу! Но я тобой горжусь."), PackedStringArray("Слышал про зомби-стоматолога? Откройте рот. Шире. Ещё шире. Приятного аппетита.", "Теперь я боюсь зубных ещё больше."), PackedStringArray("Мой план выживания прост: бегать быстрее тебя.", "Ну спасибо, друг."), PackedStringArray("Я не боюсь зомби. Я храбрый. И у меня дробовик. В основном дробовик.", "Зато честно."), PackedStringArray("Зомби-вегетарианец ходит и стонет: зерно-о-о!", "Зерно! Ну хоть не мозги."), PackedStringArray("Купил неон под машину. Теперь зомби бегут на дискотеку.", "Главное, чтобы не танцевали с тобой."), PackedStringArray("Знаешь, почему зомби не водят машину? У них нет прав. И пульса.", "Пульс важнее, согласен."), PackedStringArray("Мне сказали: держи голову холодной. Теперь ношу шапку только зомби.", "Чего? А, понял. Нет, не понял. Смешно."), PackedStringArray("Сегодня зомби постучал в ворота. Я спросил пароль. Он сказал: ы-ы-ы. Это был правильный пароль.", "Срочно меняем пароль!")])
jokes_en = Array[PackedStringArray]([PackedStringArray("Why don't zombies go to school? Their brains are already fried.", "Ha! You just fried mine."), PackedStringArray("A zombie goes to the doctor: I feel terrible. The doctor says: you look it, too.", "Ha, doctors are all like that."), PackedStringArray("I joined a gym. I run from zombies three hours a day.", "Now that's cardio!"), PackedStringArray("Why are zombies so slow? Saving energy. Brains are expensive these days.", "You know, that actually makes sense."), PackedStringArray("What do you call a zombie chef? A dead-icated cook.", "Five stars."), PackedStringArray("Knock knock. Who's there? A zombie. A zombie who? The one already inside.", "Not funny! Okay, a little funny."), PackedStringArray("Zombies never eat clowns. They taste funny.", "Ha ha! A classic."), PackedStringArray("Good news: the internet is back. Bad news: I lied.", "Why would you do that to me?"), PackedStringArray("I fixed the car with duct tape. If it doesn't hold, you didn't use enough tape.", "A true engineer."), PackedStringArray("Why are zombies bad at hide and seek? Their smell gives them away.", "And your jokes give you away."), PackedStringArray("The apocalypse. Finally, no traffic jams.", "See? There are upsides!"), PackedStringArray("I was drifting through the city yesterday. The zombies gave me a standing ovation. In pieces.", "Gross! But I'm proud of you."), PackedStringArray("Heard about the zombie dentist? Open wide. Wider. Even wider. Bon appetit.", "Now I'm even more scared of dentists."), PackedStringArray("My survival plan is simple: run faster than you.", "Thanks a lot, friend."), PackedStringArray("I'm not afraid of zombies. I'm brave. And I have a shotgun. Mostly the shotgun.", "At least you're honest."), PackedStringArray("I met a vegetarian zombie. He kept moaning: graaains!", "Grains! Better than brains, I guess."), PackedStringArray("I put neon under my car. Now the zombies think it's a disco.", "Just don't let them ask you to dance."), PackedStringArray("Know why zombies don't drive? No license. And no pulse.", "The pulse is the bigger problem, I agree."), PackedStringArray("They told me to keep a cool head. So now I only shoot the warm ones.", "What? Oh. No. Still funny."), PackedStringArray("A zombie knocked on the gate today. I asked for the password. He said: uuuh. It was the right password.", "We're changing the password right now!")])
facts_ru = PackedStringArray("Мёд не портится: в гробницах Египта находили съедобный мёд возрастом три тысячи лет.", "У осьминога три сердца и голубая кровь.", "С точки зрения ботаники банан — ягода, а клубника — нет.", "Свет от Солнца летит до Земли около восьми минут.", "Чтобы вода стала безопасной, её достаточно кипятить одну минуту — погибает большинство микробов.", "Если заблудился, иди вниз по течению ручья: вода обычно выводит к людям.", "Без еды человек может прожить около трёх недель, а без воды — всего около трёх дней.", "Молния примерно в пять раз горячее поверхности Солнца.", "Сердце синего кита размером с небольшую машину.", "Эйфелева башня летом становится выше примерно на пятнадцать сантиметров: металл расширяется от жары.", "Огню нужны топливо, кислород и жар. Убери что-то одно — и он погаснет.", "Полярная звезда всегда над севером. Найди ковш Большой Медведицы и продли его край в пять раз.", "В одной кисти руки человека двадцать семь костей.", "Акулы старше деревьев: они появились больше четырёхсот миллионов лет назад.", "Мозг человека тратит около двадцати процентов энергии тела. Может, поэтому зомби его так любят.", "Шоколад опасен для собак: в нём есть теобромин, который им вреден.", "Венера вращается в обратную сторону, и солнце там встаёт на западе.", "В воде звук распространяется примерно в четыре раза быстрее, чем в воздухе.", "Фламинго розовые из-за еды: они едят рачков с красным пигментом.", "Чтобы остановить кровь, прижми рану чистой тканью и держи минут десять, не подглядывая.", "Сапсан — самая быстрая птица: в пикировании он разгоняется больше трёхсот километров в час.", "Следы астронавтов на Луне пролежат миллионы лет — там нет ветра.", "Пчёлы танцем показывают друг другу, где искать цветы.", "В Европе помидоры долго считали ядовитыми.", "Ленивец слезает с дерева примерно раз в неделю — только чтобы сходить в туалет.", "В машине с ручником занос начинается, когда задние колёса теряют сцепление. Вот почему дрифт — это физика, а не магия.", "Улитка может проспать до трёх лет, если вокруг слишком сухо.", "Коровы заводят лучших друзей и грустят, когда их разлучают.", "Самый холодный город, где живут люди, — Оймякон в Якутии: там бывало минус семьдесят.", "Сердце человека за жизнь делает больше двух миллиардов ударов.")
facts_en = PackedStringArray("Honey never spoils: edible honey was found in Egyptian tombs, three thousand years old.", "An octopus has three hearts and blue blood.", "Botanically, a banana is a berry, but a strawberry isn't.", "Sunlight takes about eight minutes to reach the Earth.", "Boiling water for one minute kills most germs and makes it safe to drink.", "If you're lost, follow a stream downhill: water usually leads to people.", "A person can live about three weeks without food, but only about three days without water.", "Lightning is about five times hotter than the surface of the Sun.", "A blue whale's heart is about the size of a small car.", "The Eiffel Tower grows about fifteen centimetres in summer: metal expands in the heat.", "A fire needs fuel, oxygen and heat. Take away any one, and it goes out.", "The North Star always sits over the north. Find the Big Dipper and extend the edge of its cup five times.", "There are twenty seven bones in a single human hand.", "Sharks are older than trees: they appeared more than four hundred million years ago.", "The human brain uses about twenty percent of the body's energy. Maybe that's why zombies love it.", "Chocolate is dangerous for dogs: it contains theobromine, which is toxic to them.", "Venus spins backwards, so the sun rises in the west there.", "Sound travels about four times faster in water than in air.", "Flamingos are pink because of their food: tiny shrimp with a red pigment.", "To stop bleeding, press a clean cloth on the wound and hold it for ten minutes without peeking.", "The peregrine falcon is the fastest bird: over three hundred kilometres per hour in a dive.", "Astronauts' footprints on the Moon will last millions of years, because there's no wind.", "Bees dance to tell each other where to find flowers.", "In Europe, tomatoes were long believed to be poisonous.", "A sloth climbs down from its tree about once a week, just to go to the toilet.", "When you pull the handbrake, the rear wheels lose grip and the car slides. Drifting is physics, not magic.", "A snail can sleep for up to three years if the weather is too dry.", "Cows have best friends and get stressed when they're separated.", "One of the coldest inhabited places is Oymyakon in Siberia: it has dropped to minus seventy.", "A human heart beats more than two billion times in a lifetime.")
ask_ru = PackedStringArray("Расскажи что-нибудь умное.", "Удиви меня фактом.", "Чему тебя научила жизнь?", "А ты знаешь что-нибудь интересное?")
ask_en = PackedStringArray("Tell me something smart.", "Surprise me with a fact.", "What has life taught you?", "Do you know anything interesting?")
