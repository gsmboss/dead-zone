[gd_resource type="Resource" script_class="CampChatter" format=3]

[ext_resource type="Script" path="res://hub/camp_chatter.gd" id="1_chat"]

[resource]
script = ExtResource("1_chat")
dialogues_ru = Array[PackedStringArray]([PackedStringArray("Как думаешь, зомби тоже мёрзнут?", "Не знаю. Но к костру они бы точно подошли.", "Вот поэтому мы и сидим с ружьём."), PackedStringArray("Я вчера видел зомби в галстуке.", "Наверное, на работу опаздывал.", "Апокалипсис — не повод прогуливать."), PackedStringArray("Сколько дней мы уже здесь?", "Я считал по банкам тушёнки.", "И сколько?", "Сорок две банки. Значит, примерно неделя."), PackedStringArray("Слышал? Что-то скребётся за стеной.", "Это енот.", "Енот в противогазе?", "Ну, енот тоже хочет выжить."), PackedStringArray("Если выберемся, я открою кофейню.", "Назовёшь её «Последняя капля»?", "Нет. «Мозги и печеньки».", "…Я больше туда не пойду."), PackedStringArray("Наш герой опять ушёл на вылазку.", "Надеюсь, принесёт батарейки.", "А я надеюсь, что он вернётся с руками."), PackedStringArray("Ты чего такой бледный?", "Я всегда такой.", "Точно? А ну покажи язык.", "Ааа… доволен?"), PackedStringArray("Раньше я боялся пауков.", "А сейчас?", "Сейчас пауки боятся нас. Мы пахнем хуже."), PackedStringArray("Я научил собаку приносить патроны.", "У нас нет собаки.", "Ну вот поэтому патронов и мало."), PackedStringArray("Говорят, в городе ещё работает автомат с газировкой.", "Это ловушка.", "Это газировка.", "…Ладно, это аргумент."), PackedStringArray("Кто съел мою последнюю шоколадку?", "Зомби.", "Зомби не едят шоколад.", "Этот был особенный."), PackedStringArray("Как думаешь, интернет когда-нибудь вернётся?", "Надеюсь. Я не досмотрел сериал.", "А я не дочитал инструкцию к огнемёту.")])
dialogues_en = Array[PackedStringArray]([PackedStringArray("Do you think zombies get cold too?", "No idea. But they'd love this campfire.", "That's why we sit here with a shotgun."), PackedStringArray("I saw a zombie wearing a tie yesterday.", "Probably late for work.", "The apocalypse is no excuse to skip the office."), PackedStringArray("How many days have we been here?", "I count them in cans of beans.", "And?", "Forty two cans. So, about a week."), PackedStringArray("Did you hear that? Something is scratching the wall.", "It's a raccoon.", "A raccoon in a gas mask?", "Hey, raccoons want to survive too."), PackedStringArray("If we make it, I'm opening a coffee shop.", "Calling it The Last Drop?", "No. Brains and Cookies.", "I'm never going there."), PackedStringArray("Our hero went out on another run.", "Hope they bring back batteries.", "I just hope they come back with both arms."), PackedStringArray("Why are you so pale?", "I've always been like this.", "Are you sure? Show me your tongue.", "Aaah. Happy now?"), PackedStringArray("I used to be scared of spiders.", "And now?", "Now spiders are scared of us. We smell worse."), PackedStringArray("I taught the dog to fetch ammo.", "We don't have a dog.", "Well, that's why we're low on ammo."), PackedStringArray("They say a soda machine still works downtown.", "It's a trap.", "It's soda.", "Okay, fair point."), PackedStringArray("Who ate my last chocolate bar?", "A zombie.", "Zombies don't eat chocolate.", "This one was special."), PackedStringArray("Do you think the internet will ever come back?", "I hope so. I never finished my show.", "I never finished the flamethrower manual.")])
solo_ru = PackedStringArray("Тишина… Не люблю тишину.", "Надо бы почистить ружьё. Завтра. Или послезавтра.", "Эх, сейчас бы горячий душ.", "Интересно, а зомби снятся сны?", "Огонь горит. Значит, мы ещё живы.")
solo_en = PackedStringArray("Quiet... I hate quiet.", "I should clean my rifle. Tomorrow. Or the day after.", "Oh, for a hot shower right now.", "I wonder if zombies dream.", "The fire is still burning. So are we.")
