[gd_resource type="Resource" script_class="StoryFilm" format=3]

[ext_resource type="Script" path="res://story/film/story_film.gd" id="1_film"]
[ext_resource type="Script" path="res://story/film/story_shot.gd" id="2_shot"]

[sub_resource type="Resource" id="Shot_1"]
script = ExtResource("2_shot")
mood = 4
camera = "road_low"
duration = 5.0
voice_ru = "Дорога чиста. На перилах остался только мамин синий шарф. Мы его не тронули."
voice_en = "The road is clear. Only Mom's blue scarf is left on the railing. We didn't touch it."

[sub_resource type="Resource" id="Shot_2"]
script = ExtResource("2_shot")
mood = 6
camera = "camp_fire"
duration = 5.0
voice_ru = "Эти гномы на меня смотрят. Я серьёзно. Вот этот, с удочкой, особенно."
voice_en = "Those gnomes are watching me. I'm serious. That one with the fishing rod especially."
speaker = "ДЯДЯ ГОША"
pitch = 0.8

[sub_resource type="Resource" id="Shot_3"]
script = ExtResource("2_shot")
mood = 6
camera = "camp_high"
duration = 5.0
voice_ru = "«Надежда» будет завтра на рассвете. Кабан тоже. Он собрал всех, кого смог."
voice_en = "The Nadezhda arrives tomorrow at dawn. So does Kaban. He has gathered everyone he could."
speaker = "ЛЕВ"
pitch = 0.75
title = "ЗАВТРА — МОСТ"

[resource]
script = ExtResource("1_film")
id = "chapter_crossing_outro"
shots = Array[ExtResource("2_shot")]([SubResource("Shot_1"), SubResource("Shot_2"), SubResource("Shot_3")])
