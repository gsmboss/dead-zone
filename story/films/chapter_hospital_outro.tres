[gd_resource type="Resource" script_class="StoryFilm" format=3]

[ext_resource type="Script" path="res://story/film/story_film.gd" id="1_film"]
[ext_resource type="Script" path="res://story/film/story_shot.gd" id="2_shot"]

[sub_resource type="Resource" id="Shot_1"]
script = ExtResource("2_shot")
mood = 2
camera = "sidewalk"
duration = 5.0
voice_ru = "Они же почти поправились! Я им давал аспирин! Три раза в день!"
voice_en = "They were almost better! I gave them aspirin! Three times a day!"
speaker = "КОСТЯ"
pitch = 1.0

[sub_resource type="Resource" id="Shot_2"]
script = ExtResource("2_shot")
mood = 6
camera = "camp_fire"
duration = 5.0
voice_ru = "Первый пациент нового медпункта — коза Зина. Съела инструкцию от автоклава. Прогноз хороший."
voice_en = "The new first-aid post's first patient: Zina the goat. Ate the autoclave manual. Prognosis is good."

[sub_resource type="Resource" id="Shot_3"]
script = ExtResource("2_shot")
mood = 6
camera = "camp_orbit"
duration = 5.0
voice_ru = "Весь лагерь привит. Теперь об этом должны узнать все. В лесу есть вышка связи. Сорок метров."
voice_en = "The whole camp is vaccinated. Now everyone has to know. There is a radio tower in the forest. Forty meters."
speaker = "ЛЕВ"
pitch = 0.75

[resource]
script = ExtResource("1_film")
id = "chapter_hospital_outro"
shots = Array[ExtResource("2_shot")]([SubResource("Shot_1"), SubResource("Shot_2"), SubResource("Shot_3")])
