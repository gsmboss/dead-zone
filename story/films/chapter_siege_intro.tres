[gd_resource type="Resource" script_class="StoryFilm" format=3]

[ext_resource type="Script" path="res://story/film/story_film.gd" id="1_film"]
[ext_resource type="Script" path="res://story/film/story_shot.gd" id="2_shot"]

[sub_resource type="Resource" id="Shot_1"]
script = ExtResource("2_shot")
mood = 3
camera = "bandit_orbit"
duration = 5.0
caption = "РАДИОЭФИР. НОЧЬ"
voice_ru = "Эй, лагерь! Это Кабан! Барон — тряпка, а я — нет. Верните пленных, или я приведу к вам гостей. Много. Голодных."
voice_en = "Hey, camp! This is Kaban! The Baron's a wimp, I'm not. Give back the prisoners, or I'll bring you guests. Lots of them. Hungry ones."
speaker = "КАБАН"
pitch = 0.5

[sub_resource type="Resource" id="Shot_2"]
script = ExtResource("2_shot")
mood = 6
camera = "camp_high"
duration = 5.0
voice_ru = "Он гремит кастрюлями за забором и тащит к нам всю орду с трассы. Умно. Подло, но умно."
voice_en = "He's banging pots behind the fence, dragging the whole highway horde to us. Smart. Nasty, but smart."
speaker = "ЛЕВ"
pitch = 0.75

[sub_resource type="Resource" id="Shot_3"]
script = ExtResource("2_shot")
mood = 6
camera = "camp_fire"
duration = 5.0
voice_ru = "Я держу ворота. Я двадцать лет охранял парковку универмага. Мимо меня даже тележка не проезжала."
voice_en = "I'll hold the gate. I guarded a department store parking lot for twenty years. Not even a shopping cart got past me."
speaker = "ГЕНКА"
pitch = 0.6

[sub_resource type="Resource" id="Shot_4"]
script = ExtResource("2_shot")
mood = 2
camera = "zombie_low"
duration = 4.0
voice_ru = "Мертвецы шли на кастрюли. Правило №13: никогда не готовь громко."
voice_en = "The dead followed the pots. Rule No. 13: never cook loudly."
effect = "shake"

[sub_resource type="Resource" id="Shot_5"]
script = ExtResource("2_shot")
mood = 5
camera = "aerial"
duration = 3.0
title = "ГЛАВА 9\nОСАДА"

[resource]
script = ExtResource("1_film")
id = "chapter_siege_intro"
shots = Array[ExtResource("2_shot")]([SubResource("Shot_1"), SubResource("Shot_2"), SubResource("Shot_3"), SubResource("Shot_4"), SubResource("Shot_5")])
