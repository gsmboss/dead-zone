[gd_resource type="Resource" script_class="StoryFilm" format=3]

[ext_resource type="Script" path="res://story/film/story_film.gd" id="1_film"]
[ext_resource type="Script" path="res://story/film/story_shot.gd" id="2_shot"]

[sub_resource type="Resource" id="Shot_1"]
script = ExtResource("2_shot")
mood = 2
camera = "sidewalk"
duration = 5.5
caption = "УЛИЦА МОЛЧАНИЯ"
voice_ru = "Раньше эту улицу звали Садовой. Тут продавали мороженое и чинили велосипеды."
voice_en = "This street used to be called Garden Street. They sold ice cream and fixed bicycles here."

[sub_resource type="Resource" id="Shot_2"]
script = ExtResource("2_shot")
mood = 0
camera = "sidewalk"
duration = 5.0
caption = "ГОД НАЗАД"
voice_ru = "Тёма однажды сломал здесь велосипед, а потом три часа уговаривал мастера починить его бесплатно. Уговорил."
voice_en = "Tyoma once broke his bike here and spent three hours persuading the mechanic to fix it for free. He succeeded."

[sub_resource type="Resource" id="Shot_3"]
script = ExtResource("2_shot")
mood = 2
camera = "window"
duration = 5.5
caption = "СЕЙЧАС"
voice_ru = "Теперь её зовут улицей Молчания. Потому что живые здесь молчат. А мёртвые — нет."
voice_en = "Now it's called Silence Street. Because the living keep quiet here. The dead don't."

[sub_resource type="Resource" id="Shot_4"]
script = ExtResource("2_shot")
mood = 2
camera = "zombie_low"
duration = 5.0
voice_ru = "В магазине заперлась семья. Отец и двое детей. Пятый день на одних чипсах."
voice_en = "A family's locked in the store. A father and two kids. Five days on nothing but potato chips."
speaker = "ДЕНИС"
pitch = 0.9

[sub_resource type="Resource" id="Shot_5"]
script = ExtResource("2_shot")
mood = 5
camera = "aerial"
duration = 3.0
title = "ГЛАВА 2\nУЛИЦА МОЛЧАНИЯ"

[resource]
script = ExtResource("1_film")
id = "chapter_2_intro"
shots = Array[ExtResource("2_shot")]([SubResource("Shot_1"), SubResource("Shot_2"), SubResource("Shot_3"), SubResource("Shot_4"), SubResource("Shot_5")])
