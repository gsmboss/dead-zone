[gd_resource type="Resource" script_class="StoryFilm" format=3]

[ext_resource type="Script" path="res://story/film/story_film.gd" id="1_film"]
[ext_resource type="Script" path="res://story/film/story_shot.gd" id="2_shot"]

[sub_resource type="Resource" id="Shot_1"]
script = ExtResource("2_shot")
mood = 11
camera = "ind_fire"
duration = 5.0
voice_ru = "Это за парковку!"
voice_en = "That's for the parking lot!"
speaker = "ГЕНКА"
pitch = 0.6
effect = "shake"

[sub_resource type="Resource" id="Shot_2"]
script = ExtResource("2_shot")
mood = 3
camera = "bandit_orbit"
duration = 5.0
voice_ru = "Кабан снова ушёл — за самой толстой бочкой был лаз. Генка был прав. Наполовину."
voice_en = "Kaban got away again: behind the fattest barrel there was a hole. Genka was right. Half right."

[sub_resource type="Resource" id="Shot_3"]
script = ExtResource("2_shot")
mood = 6
camera = "camp_fire"
duration = 5.0
voice_ru = "Двое его парней теперь моют посуду. Говорят, у нас хоть кормят."
voice_en = "Two of his guys wash dishes now. They say at least we feed people here."
speaker = "ДЯДЯ ГОША"
pitch = 0.8

[resource]
script = ExtResource("1_film")
id = "chapter_trail_outro"
shots = Array[ExtResource("2_shot")]([SubResource("Shot_1"), SubResource("Shot_2"), SubResource("Shot_3")])
