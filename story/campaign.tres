mission = ExtResource("m_chapter_resort")
intro_pages = PackedStringArray("«НАДЕЖДА» ВСТАЛА В БУХТЕ У КУРОРТА «ЧАЙКА». ДО ГОР, ГДЕ ЖДУТ ДВЕСТИ ЧЕЛОВЕК, — ДВА ДНЯ ПО СЕРПАНТИНУ. КОРАБЛЬ ТУДА НЕ ДОПЛЫВЁТ.", "НА НАБЕРЕЖНОЙ — МЕРТВЕЦЫ В ПАНАМАХ, КУПАЛЬНИКАХ И С НАДУВНЫМИ КРУГАМИ. ВСЁ ВКЛЮЧЕНО, ВКЛЮЧАЯ ЗУБЫ.", "НА КРЫШЕ КАФЕ ТАНЦУЕТ АНИМАТОР ЭДИК: ПОКА ОН ТАНЦУЕТ, ЗОМБИ СМОТРЯТ НА НЕГО, А НЕ ИЩУТ ЕДУ. ОН ТАНЦУЕТ ТРЕТИЙ ДЕНЬ. РАСЧИСТИ НАБЕРЕЖНУЮ.")
outro_pages = PackedStringArray("ЭДИК СПУСТИЛСЯ С КРЫШИ, ЛЁГ НА ПЕСОК И СКАЗАЛ: «СЛЕДУЮЩАЯ ДИСКОТЕКА — БЕЗ МЕНЯ». ПОТОМ ПОДУМАЛ И ДОБАВИЛ: «НО ЕСЛИ НАДО — ЗОВИТЕ».", "У ЭДИКА ЕСТЬ КУРОРТНЫЙ АВТОБУС «ЛАСТОЧКА» — РОЗОВЫЙ, С ПАЛЬМАМИ НА БОРТУ. ДЕНИС БЫ ЗАПЛАКАЛ. ТЁМА ЕГО УЖЕ ЧИНИТ.", "ЯКОРЕВ ОСТАЁТСЯ В БУХТЕ И ЖДЁТ НАС. ВАКЦИНА — В ХОЛОДИЛЬНИКЕ АВТОБУСА, РЯДОМ С ЭДИКОВЫМ ЛИМОНАДОМ. ВПЕРЁД, В ГОРЫ.")
