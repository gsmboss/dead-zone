[resource]
script = ExtResource("1_camp")
prologue_pages = PackedStringArray("СЕВЕР-9. ГОД ДО ВСЕГО ЭТОГО. ГОРОД, ГДЕ СВЕТОФОРЫ РАБОТАЛИ, АВТОБУСЫ ХОДИЛИ ПО РАСПИСАНИЮ, А САМОЙ СТРАШНОЙ БЕДОЙ БЫЛА ПРОБКА НА ПРОСПЕКТЕ.", "МЫ ЖИЛИ НА САДОВОЙ: МАМА, Я И МОЙ МЛАДШИЙ БРАТ ТЁМА. ДВЕНАДЦАТЬ ЛЕТ, СОРОК КИЛОГРАММОВ УПРЯМСТВА И ВЕЧНО РАЗРЯЖЕННЫЙ ТЕЛЕФОН.", "ЗА РЕКОЙ РАБОТАЛА ЛАБОРАТОРИЯ «ГЕНОМ». ОНИ ИСКАЛИ ЛЕКАРСТВО ОТ СТАРОСТИ — И НАШЛИ «ГНИЛЬ-7». ОНА НЕ ЛЕЧИЛА СТАРОСТЬ. ОНА ОТМЕНЯЛА СМЕРТЬ.", "ДЕНЬ НОЛЬ, 18:40. ПОЖАР В «ГЕНОМЕ». ЧЕРЕЗ ЧАС ПО ГОРОДУ БЕЖАЛИ ЛЮДИ. ЧЕРЕЗ ДВА — ЗА НИМИ БЕЖАЛИ ТЕ, КТО УЖЕ НЕ БЫЛ ЛЮДЬМИ.", "МАМА ОСТАЛАСЬ, ЧТОБЫ МЫ УСПЕЛИ К МОСТУ. ОНА НЕ ДОГНАЛА. А ПОТОМ ТОЛПА РАЗОРВАЛА НАС С ТЁМОЙ.", "ТРИ МЕСЯЦА СПУСТЯ. МАМУ Я ПОХОРОНИЛ У СТАРОЙ ЧАСОВНИ. ТЁМУ НЕ НАШЁЛ. А РАЗ НЕ НАШЁЛ — ЗНАЧИТ, ОН ЖИВ.", "У МЕНЯ ЕСТЬ УБЕЖИЩЕ ИЗ КОНТЕЙНЕРОВ, НОЖ, ПИСТОЛЕТ И ПРАВИЛА ВЫЖИВАНИЯ. ПРАВИЛО №1: ВСЕГДА ПРОВЕРЯЙ ЗАДНЕЕ СИДЕНЬЕ.", "Я НАЙДУ БРАТА. И ВСЕХ, КТО ЕЩЁ ДЫШИТ.")
epilogue_pages = PackedStringArray("ГНЕЗДО В ЦЕХАХ СГОРЕЛО. ВПЕРВЫЕ ЗА МЕСЯЦЫ НОЧЬ ТИХАЯ — ДАЖЕ ГИТАРА МОЛЧИТ.", "ДЯДЯ ГОША ОТКРЫЛ В ЛАГЕРЕ КОФЕЙНЮ «ПОСЛЕДНЯЯ КАПЛЯ». ШНЫРЬ ВЕДЁТ БУХГАЛТЕРИЮ. БАРОН МОЕТ ПОСУДУ И НАЗЫВАЕТ КУХНЮ СВОИМ КОРОЛЕВСТВОМ.", "УЧЁНЫЕ ДЕЛАЮТ ВАКЦИНУ. ЛЕВ ЛОВИТ ГОЛОСА С ЮГА: ТАМ ТОЖЕ ВЫЖИЛИ.", "ТЁМА ЧИНИТ ВСЁ, ЧТО ВИДИТ, И СПОРИТ С ДЕНИСОМ, КАКАЯ МАШИНА ЛУЧШЕ ДРИФТУЕТ. МАМА БЫ СМЕЯЛАСЬ.", "МЁРТВЫХ ЕЩЁ МНОГО. НО ТЕПЕРЬ У НАС ЕСТЬ ДОМ — И ТЕ, РАДИ КОГО СТОИТ ВОЗВРАЩАТЬСЯ.", "КАМПАНИЯ ПРОЙДЕНА. ГОРОД, БЕСКОНЕЧНАЯ ОБОРОНА И ИГРА С ДРУЗЬЯМИ ЖДУТ.")
prologue_film = ExtResource("f_prologue")
epilogue_film = ExtResource("f_epilogue")
chapters = Array[ExtResource("2_chap")]([SubResource("chapter_1"), SubResource("chapter_2"), SubResource("chapter_3"), SubResource("chapter_4"), SubResource("chapter_bandits"), SubResource("chapter_5"), SubResource("chapter_6"), SubResource("chapter_baron"), SubResource("chapter_7")])
