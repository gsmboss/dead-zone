mission = ExtResource("m_chapter_home")
intro_pages = PackedStringArray("«НАДЕЖДА» ШЛА ДОМОЙ НА ВСЕХ ПАРАХ. БОРЩОВ ВАРИЛ БОРЩ ДЛЯ ВСЕХ, ЭДИК УЧИЛ ДЕРЕВЕНСКИХ ТАНЦЕВАТЬ, ТЁМА СПАЛ НА МЕШКЕ С КАРТОШКОЙ.", "НАШ МАЯК ГОРЕЛ: ПАЛЫЧ ЖДАЛ. А ЗА ЛАГЕРЕМ, ДО САМОГО ГОРИЗОНТА, ШЛИ МЕРТВЕЦЫ. ТЫСЯЧИ. ВСЕ, КОГО КОГДА-ТО ГНАЛ ПАСТУХ.", "ЗАЩИТИ ДОМ. ВСЕ НА МЕСТАХ: ДЕНИС НА ГРУЗОВИКЕ, ГЕНКА НА ВОРОТАХ, КАБАН С ПОДНОСОМ, ДЯДЯ ГОША С ТЕРМОСОМ. ПРАВИЛО ПОСЛЕДНЕЕ: ВОЗВРАЩАЙСЯ ДОМОЙ.")
outro_pages = PackedStringArray("ОРДА КОНЧИЛАСЬ НА РАССВЕТЕ. ПОСЛЕДНЕГО МЕРТВЕЦА ВМЕСТЕ УЛОЖИЛИ ГЕНКА И КАБАН — ВОРОТАМИ И ПОДНОСОМ. ОНИ ТЕПЕРЬ ЛУЧШИЕ ДРУЗЬЯ.", "НА ЗАВТРАК БЫЛО ВСЁ СРАЗУ: БОРЩ БОРЩОВА, ЗАМОРОЖЕННЫЙ ЭСПРЕССО ЛЮБЫ, ПЛОМБИР МИХАЛЫЧА И ПИРОГИ БАБЫ ШУРЫ. КОЗА ЗИНА СЪЕЛА СКАТЕРТЬ.", "Я СМОТРЕЛ НА НИХ И ДУМАЛ: МАМА БЫ СМЕЯЛАСЬ. МЫ ДОМА. ВСЕ.")
