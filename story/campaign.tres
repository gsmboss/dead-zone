location_name = "ЛАГЕРЬ ВЫЖИВШИХ"
part = 2
map_position = Vector2(0.92, 0.4)
mission = ExtResource("m_chapter_feast")
intro_pages = PackedStringArray("ВАКЦИНА УШЛА НА ЮГ, КАБАН МОЕТ ПОСУДУ, ТЁМА РЯДОМ. ДЯДЯ ГОША ОБЪЯВИЛ ПЕРВЫЙ В ИСТОРИИ ЛАГЕРЯ КОФЕЙНЫЙ ФЕСТИВАЛЬ.", "ПРОГРАММА: КОНКУРС НА САМЫЙ КРЕПКИЙ КОФЕ, ТАНЦЫ, ГИТАРА ВЕРЫ И САЛЮТ ИЗ СИГНАЛЬНЫХ РАКЕТ. ПРО САЛЮТ ПОДУМАЛИ НЕ ВСЕ.", "САЛЮТ УВИДЕЛИ ВСЕ МЕРТВЕЦЫ НА ДЕСЯТЬ КИЛОМЕТРОВ ВОКРУГ. ОТБЕЙ ЧЕТЫРЕ ВОЛНЫ — ПРАЗДНИК ДОЛЖЕН ПРОДОЛЖАТЬСЯ.")
outro_pages = PackedStringArray("ПОСЛЕДНЕГО ЗОМБИ СБИЛ С НОГ КАБАН — ПОДНОСОМ. ГЕНКА СКАЗАЛ, ЧТО ГОРДИТСЯ ИМ. КАБАН ПОКРАСНЕЛ.", "КОНКУРС НА САМЫЙ КРЕПКИЙ КОФЕ ВЫИГРАЛА ЛЮБА: ОНА ЗАМОРОЗИЛА ЭСПРЕССО И ПОДАЛА ЕГО КАК ПЛОМБИР. ДЯДЯ ГОША ПРИЗНАЛ ПОРАЖЕНИЕ ВПЕРВЫЕ В ЖИЗНИ.", "ДВЕ НЕДЕЛИ БЫЛО ТИХО. ПОТОМ ЛЕВ ПОЙМАЛ ЮЖНЫЙ ПОРТ. ГОЛОС ЯКОРЕВА БЫЛ ХРИПЛЫМ. НО ЭТО УЖЕ ДРУГАЯ ИСТОРИЯ.")
intro_film = ExtResource("f_chapter_feast_intro")
outro_film = ExtResource("f_chapter_feast_outro")
