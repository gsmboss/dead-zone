outro_pages = PackedStringArray("ПАСТУХ РУХНУЛ В СНЕГ И ЗАМОЛЧАЛ. ВПЕРВЫЕ ЗА МЕСЯЦЫ В ГОРАХ СТАЛО ТИХО — ТАК ТИХО, ЧТО СЛЫШНО, КАК ПАДАЕТ СНЕГ.", "СТАДО БЕЗ ПАСТУХА РАЗБРЕЛОСЬ ПО СКЛОНАМ. БЕЗ НЕГО ОНИ ПРОСТО МЕРТВЕЦЫ. ОПАСНЫЕ, НО ГЛУПЫЕ.", "ЛЕВ ВЫШЕЛ НА СВЯЗЬ ИЗ ЛАГЕРЯ. ГОЛОС ВСТРЕВОЖЕННЫЙ: «ВОЗВРАЩАЙТЕСЬ. СКОРЕЕ. К НАМ ИДЁТ ОРДА — САМАЯ БОЛЬШАЯ ИЗ ВСЕХ».")
