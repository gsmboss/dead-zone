intro_pages = PackedStringArray("ЮЖНЫЙ ПОРТ. КРАНЫ ЗАМЕРЛИ НАД ВОДОЙ, КОНТЕЙНЕРЫ СТОЯТ, КАК ДОМИНО. У ПРИЧАЛА — БЕЛЫЙ КОРАБЛЬ «НАДЕЖДА». НА МОСТИКЕ МИГАЕТ ФОНАРИК: ЯКОРЕВ ЖИВ.", "БАКИ ПУСТЫ. ТОПЛИВО — В КАНИСТРАХ ПО ВСЕМУ ПОРТУ: НА ПИРСЕ, У МАЯКА, МЕЖДУ КОНТЕЙНЕРАМИ. МЕРТВЕЦЫ ИДУТ НА ЗАПАХ СОЛЯРКИ — НЕ СПРАШИВАЙ ПОЧЕМУ.", "СОБЕРИ ШЕСТЬ КАНИСТР. КОК БОРЩОВ ОБЕЩАЛ ЗА КАЖДУЮ ТАРЕЛКУ БОРЩА. ТЁМА ТОРГУЕТСЯ НА ДВЕ.")
outro_pages = PackedStringArray("ЯКОРЕВ ОБНЯЛ МЕНЯ ТАК, ЧТО ХРУСТНУЛА РАЦИЯ. ЭКИПАЖ ДВЕ НЕДЕЛИ ДЕРЖАЛСЯ НА МОСТИКЕ НА СУХАРЯХ И МОРСКИХ АНЕКДОТАХ. АНЕКДОТЫ КОНЧИЛИСЬ РАНЬШЕ.", "БОРЩОВ СДЕРЖАЛ СЛОВО: БОРЩ БЫЛ ИЗ КОНСЕРВОВ, НО ГОРЯЧИЙ. ТЁМА СЪЕЛ ДВЕ ТАРЕЛКИ И ПОТРЕБОВАЛ ТРЕТЬЮ «ЗА ПЕРЕГОВОРЫ».", "ОСТАЛАСЬ БЕДА: ВЫХОД ИЗ ГАВАНИ — МЕЖДУ РИФАМИ. НОЧЬЮ БЕЗ МАЯКА НЕ ПРОЙТИ, А ДНЁМ МЕРТВЕЦЫ ЛЕЗУТ НА ПРИЧАЛ. НУЖЕН СВЕТ.")
