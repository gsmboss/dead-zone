outro_pages = PackedStringArray("МАЯК ЗАЖЁГСЯ. ЛУЧ ПРОШЁЛ ПО ВОДЕ, ПО КРАНАМ, ПО НАШИМ ЛИЦАМ. ПАЛЫЧ ПРОСЛЕЗИЛСЯ: «ТРИ МЕСЯЦА НИКТО НЕ ВИДЕЛ МОЙ СВЕТ».", "А ПОТОМ ЛУЧ ВЫХВАТИЛ ИЗ ВОДЫ ЧТО-ТО ОГРОМНОЕ. ОНО СТОЯЛО ПО ПОЯС В МОРЕ И СМОТРЕЛО НА МАЯК. ПАЛЫЧ СКАЗАЛ, ЧТО ЭТО ГРУЗЧИК. ЯКОРЕВ СКАЗАЛ: «УТОПЛЕННИК».", "ОТПЛЫВАЕМ НА РАССВЕТЕ. ПАЛЫЧ ВЫВЕДЕТ КОРАБЛЬ ЗА РИФЫ НА СВОЕЙ ЛОДКЕ. МАЯК ОСТАВИЛИ ГОРЕТЬ: ПУСТЬ ТЕ, КТО ЕЩЁ В ПУТИ, ЗНАЮТ, КУДА ИДТИ.")
