[sub_resource type="Resource" id="chapter_1"]
script = ExtResource("2_chap")
id = "chapter_1"
title = "ПЕРВЫЙ ДЕНЬ"
location_name = "СТОЯНКА КОНТЕЙНЕРОВ"
part = 1
map_position = Vector2(0.07, 0.78)
mission = ExtResource("m_chapter_1")
intro_pages = PackedStringArray("ДЕНЬ 92. РАЦИЯ, КОТОРАЯ ТРИ МЕСЯЦА ШИПЕЛА, ВДРУГ ЗАГОВОРИЛА ЖЕНСКИМ ГОЛОСОМ: «МЫ НА СТОЯНКЕ У ТРАССЫ, НАС ДВОЕ, БРАТ РАНЕН!»", "СТОЯНКА В ДВУХ КИЛОМЕТРАХ. ЗОМБИ УЖЕ ТАМ — ОНИ ВСЕГДА ПРИХОДЯТ РАНЬШЕ. БЕРИ НОЖ И ПИСТОЛЕТ.", "ПРАВИЛО №2: НЕ УЛЫБАЙСЯ, КОГДА ВОКРУГ ЗОМБИ. ПРАВИЛО №3: ЕСЛИ УЛЫБНУЛСЯ — БЕГИ.")
outro_pages = PackedStringArray("МАРИНА И ЕЁ БРАТ ДЕНИС ТЕПЕРЬ В УБЕЖИЩЕ. ДЕНИС — МЕХАНИК: ОН ОБЕЩАЕТ ПОЧИНИТЬ ЛЮБУЮ МАШИНУ. ДАЖЕ ТУ, ЧТО БЕЗ КОЛЁС.", "МАРИНА ВИДЕЛА НЕДЕЛЮ НАЗАД МАЛЬЧИШКУ С КРАСНЫМ РЮКЗАКОМ. ОН ШЁЛ К УЛИЦЕ МОЛЧАНИЯ И РУГАЛСЯ НА ЗОМБИ, КАК ВЗРОСЛЫЙ.", "КРАСНЫЙ РЮКЗАК. МАМА КУПИЛА ЕГО ТЁМЕ ПЕРЕД ШКОЛОЙ. ОН НЕНАВИДЕЛ ЭТОТ ЦВЕТ.")
intro_film = ExtResource("f_chapter_1_intro")
outro_film = ExtResource("f_chapter_1_outro")
rescued = 2

[sub_resource type="Resource" id="chapter_2"]
script = ExtResource("2_chap")
id = "chapter_2"
title = "УЛИЦА МОЛЧАНИЯ"
location_name = "УЛИЦА"
part = 1
map_position = Vector2(0.25, 0.56)
mission = ExtResource("m_chapter_2")
intro_pages = PackedStringArray("РАНЬШЕ ЭТО БЫЛА САДОВАЯ: МОРОЖЕНОЕ, ВЕЛОМАСТЕРСКАЯ, БАБУШКИ НА ЛАВОЧКАХ. ТЕПЕРЬ ЕЁ ЗОВУТ УЛИЦЕЙ МОЛЧАНИЯ.", "В МАГАЗИНЕ ПЯТЫЙ ДЕНЬ СИДИТ СЕМЬЯ: ОТЕЦ И ДВОЕ ДЕТЕЙ. ЕДЯТ ЧИПСЫ. ДЕТИ СЧАСТЛИВЫ, ОТЕЦ — НЕТ.", "РАСЧИСТИ УЛИЦУ. И ПОСМОТРИ ПО СТОРОНАМ: ЕСЛИ ТЁМА БЫЛ ЗДЕСЬ, ОН ОСТАВИЛ СЛЕД. ОН ВСЕГДА ОСТАВЛЯЕТ СЛЕДЫ. ОБЫЧНО — ФАНТИКИ.")
outro_pages = PackedStringArray("СЕМЬЯ СПАСЕНА. А НА СТЕНЕ МАГАЗИНА — НАДПИСЬ МАРКЕРОМ: «Я ЖИВ. ИДУ К ЛЕСУ. Т.»", "ВО ДВОРЕ ДЕНИС НАШЁЛ ПИКАП И ЗА НОЧЬ ПРЕВРАТИЛ ЕГО В БРОНЕПИКАП. «ЭТО НЕ РЕМОНТ, ЭТО ИСКУССТВО», — СКАЗАЛ ОН И УСНУЛ ПРЯМО ПОД МАШИНОЙ.", "ТВОЯ ПЕРВАЯ МАШИНА. В АВТОСАЛОНЕ ОНА УЖЕ ТВОЯ, А В ГОРОДЕ ЖДЁТ У СТАРТА.")
intro_film = ExtResource("f_chapter_2_intro")
outro_film = ExtResource("f_chapter_2_outro")
rescued = 3
unlock_car = ExtResource("car_2")
unlock_car_name = "БРОНЕПИКАП"

[sub_resource type="Resource" id="chapter_3"]
script = ExtResource("2_chap")
id = "chapter_3"
title = "ЛЕСНОЙ ЛАГЕРЬ"
location_name = "ЛЕС"
part = 1
map_position = Vector2(0.08, 0.3)
mission = ExtResource("m_chapter_3")
intro_pages = PackedStringArray("В ЛЕСУ ЗА ТРАССОЙ — ДЫМ КОСТРОВ. ЭТО РАЗВЕДЧИКИ ВЕРЫ: ЧЕТВЕРО, С ПАЛАТКАМИ, ИНСТРУМЕНТАМИ И ГИТАРОЙ, НА КОТОРОЙ НИКТО НЕ УМЕЕТ ИГРАТЬ.", "ВЕРА ВИДЕЛА МАЛЬЧИКА С КРАСНЫМ РЮКЗАКОМ. ОН УШЁЛ ТРИ ДНЯ НАЗАД. НЕ ОДИН.", "НОЧЬЮ ЗОМБИ ИДУТ НА ОГОНЬ. ПРОДЕРЖИСЬ, ПОКА РАЗВЕДЧИКИ СОБИРАЮТ ЛАГЕРЬ. ФАКЕЛ БУДЕТ КСТАТИ.")
outro_pages = PackedStringArray("РАЗВЕДЧИКИ ПЕРЕБРАЛИСЬ К НАМ И ПОСТРОИЛИ ПЕРВЫЙ ДОМ В ЛАГЕРЕ. ГИТАРУ ТОЖЕ ПРИВЕЗЛИ. ЛУЧШЕ БЫ НЕТ.", "ВЕРА РАССКАЗАЛА ГЛАВНОЕ: ТЁМУ УВЕЛИ ЛЮДИ В КРАСНЫХ ПЛАТКАХ. БАНДА «СТЕРВЯТНИКИ». ИХ ГЛАВНЫЙ ЗОВЁТ СЕБЯ БАРОНОМ.", "ВЕРА ЕЩЁ СЛЫШАЛА В ЭФИРЕ ЧУЖОЙ ПОЗЫВНОЙ. СИГНАЛ ИДЁТ СО СТАРОГО КЛАДБИЩА. С ТОГО САМОГО.")
intro_film = ExtResource("f_chapter_3_intro")
outro_film = ExtResource("f_chapter_3_outro")
rescued = 4
unlock_house = true

[sub_resource type="Resource" id="chapter_4"]
script = ExtResource("2_chap")
id = "chapter_4"
title = "НОЧЬ НА КЛАДБИЩЕ"
location_name = "КЛАДБИЩЕ"
part = 1
map_position = Vector2(0.28, 0.1)
mission = ExtResource("m_chapter_4")
intro_pages = PackedStringArray("КЛАДБИЩЕ У ЧАСОВНИ. ЗДЕСЬ ЛЕЖИТ МАМА. ТРИ МЕСЯЦА Я НЕ МОГ СЮДА ВЕРНУТЬСЯ.", "В СКЛЕПЕ ПРЯЧЕТСЯ РАДИСТ ЛЕВ С ДОЧКОЙ СОНЕЙ. ЕГО РАЦИЯ РАЗБИТА, ДЕТАЛИ РАЗБРОСАНЫ СРЕДИ МОГИЛ.", "МЁРТВЫЕ ЗДЕСЬ ВСТАЮТ ИЗ ЗЕМЛИ — ТАК И ДОЛЖНО БЫТЬ НА КЛАДБИЩЕ, ТОЛЬКО ОТ ЭТОГО НЕ ЛЕГЧЕ. СОБЕРИ ДЕТАЛИ.")
outro_pages = PackedStringArray("У МАМИНОЙ МОГИЛЫ КТО-ТО ПОСАДИЛ ЦВЕТЫ. ДЕТСКОЙ РУКОЙ, КРИВО, НО ОЧЕНЬ СТАРАТЕЛЬНО. ТЁМА БЫЛ ЗДЕСЬ.", "ЛЕВ СОБРАЛ РАЦИЮ, И В ЭФИР ВОРВАЛСЯ БАРОН: «ГОРОД МОЙ. НАЛОГ — ТУШЁНКА, БЕНЗИН И ПАТРОНЫ».", "БАРОН ХВАСТАЛСЯ МАЛЬЧИШКОЙ, КОТОРЫЙ ЧИНИТ ЛЮБУЮ РАЦИЮ. «ЕСТ ЗА ТРОИХ, ВСЕХ БЕСИТ, НО РУКИ ЗОЛОТЫЕ». ЭТО ТЁМА. ТОЧНО ТЁМА.")
intro_film = ExtResource("f_chapter_4_intro")
outro_film = ExtResource("f_chapter_4_outro")
rescued = 2

[sub_resource type="Resource" id="chapter_bandits"]
script = ExtResource("2_chap")
id = "chapter_bandits"
title = "СТЕРВЯТНИКИ"
location_name = "СТОЯНКА КОНТЕЙНЕРОВ"
part = 1
map_position = Vector2(0.47, 0.36)
mission = ExtResource("m_chapter_bandits")
intro_pages = PackedStringArray("КОЛОННА БЕЖЕНЦЕВ ОТКАЗАЛАСЬ ПЛАТИТЬ БАРОНУ НАЛОГ. ТЕПЕРЬ СТЕРВЯТНИКИ ЗАБИРАЮТ У НИХ ВСЁ — ВМЕСТЕ С МАШИНАМИ И ЛЮДЬМИ.", "БАНДИТЫ НЕ ЗОМБИ: ОНИ СТРЕЛЯЮТ, ПРЯЧУТСЯ И ОРУТ ГЛУПОСТИ. ЗАТО ИХ МОЖНО ДОПРОСИТЬ.", "ПРАВИЛО №7: ОТ БАНДИТОВ ПРЯЧЬСЯ ЗА СТЕНОЙ, ОТ ЗОМБИ — УБЕГАЙ. ПЕРЕПУТАЕШЬ — БУДЕТ ОБИДНО.")
outro_pages = PackedStringArray("КОЛОННА СПАСЕНА: ТРОЕ ВЗРОСЛЫХ И КОЗА ПО ИМЕНИ ЗИНА. КОЗУ НИКТО НЕ ПРОСИЛ, НО ОНА ТЕПЕРЬ ТОЖЕ В ЛАГЕРЕ.", "ВЗЯЛИ ПЛЕННОГО — ШНЫРЯ. ДО АПОКАЛИПСИСА ОН БЫЛ БУХГАЛТЕРОМ И ДО СИХ ПОР СЧИТАЕТ ВСЕХ ЗОМБИ В ТЕТРАДКУ.", "ШНЫРЬ СДАЛ ВСЕХ ЗА ПЯТЬ МИНУТ И ОДНУ БАНКУ ТУШЁНКИ: ТЁМА НА СКЛАДЕ БАРОНА В ПРОМЗОНЕ. ЖИВОЙ И ОЧЕНЬ НАДОЕДЛИВЫЙ.")
intro_film = ExtResource("f_chapter_bandits_intro")
outro_film = ExtResource("f_chapter_bandits_outro")
rescued = 3

[sub_resource type="Resource" id="chapter_5"]
script = ExtResource("2_chap")
id = "chapter_5"
title = "ПРОМЗОНА"
location_name = "ПРОМЗОНА"
part = 1
map_position = Vector2(0.66, 0.1)
mission = ExtResource("m_chapter_5")
intro_pages = PackedStringArray("ПЯТЕРО РАБОЧИХ ДЕРЖАТ ЗАПРАВКУ ПОСРЕДИ ПРОМЗОНЫ. БЕЗ ТОПЛИВА ИХ ГЕНЕРАТОРЫ ВСТАНУТ, А СКЛАД БАРОНА — СРАЗУ ЗА ЗАБОРОМ.", "УДЕРЖИ ТОЧКУ, ПОКА ОНИ ЗАЛИВАЮТ БОЧКИ. СТЕРВЯТНИКИ ТОЖЕ ХОТЯТ ТОПЛИВО. И ВЗРЫВНЫЕ ЗОМБИ ХОТЯТ… ПРОСТО ВЗОРВАТЬСЯ.", "БОЧКИ С КРАСНОЙ ПОЛОСОЙ ВЗРЫВАЮТСЯ. ИСПОЛЬЗУЙ ЭТО. ГЛАВНОЕ — НЕ СТОЙ РЯДОМ.")
