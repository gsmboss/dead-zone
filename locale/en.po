msgid "ГЛАВА ПРОЙДЕНА  •  %s"
msgstr "CHAPTER COMPLETE  •  %s"

msgid "ГЛАВНАЯ У УЧЁНЫХ — ДОКТОР ИРИНА. ЕЙ НУЖНЫ РЕАКТИВЫ, ХОЛОДИЛЬНИК И НОРМАЛЬНЫЙ КОФЕ. ДЯДЯ ГОША ВПЕРВЫЕ ВСТРЕТИЛ РАВНОГО ПРОТИВНИКА."
msgstr "THE SCIENTISTS' LEADER IS DOCTOR IRINA. SHE NEEDS REAGENTS, A FRIDGE AND DECENT COFFEE. UNCLE GOSHA HAS MET HIS MATCH FOR THE FIRST TIME."

msgid "ГЛУШИТЕЛЬ"
msgstr "SILENCER"

msgid "ГНИЛЯК"
msgstr "GHOUL"

msgid "ГНОМЫ ТЕПЕРЬ ЖИВУТ В ЛАГЕРЕ У КОСТРА. ДЯДЯ ГОША ГОВОРИТ, ЧТО ОНИ НА НЕГО СМОТРЯТ. ГНОМЫ МОЛЧАТ."
msgstr "THE GNOMES NOW LIVE IN THE CAMP BY THE FIRE. UNCLE GOSHA SAYS THEY ARE WATCHING HIM. THE GNOMES SAY NOTHING."

msgid "ГОД НАЗАД"
msgstr "A YEAR AGO"

msgid "ГОЛОДАЮТ"
msgstr "STARVING"

msgid "ГОЛОС МАМЫ"
msgstr "MOM'S VOICE"

msgid "ГОЛОСА ВЫЖИВШИХ В УБЕЖИЩЕ"
msgstr "SURVIVOR VOICES IN THE SHELTER"

msgid "ГОЛОСА ГЕРОЕВ: НЕЙРОСЕТЬ PIPER"
msgstr "CHARACTER VOICES: PIPER NEURAL TTS"

msgid "ГОЛОСА С ЮГА"
msgstr "VOICES FROM THE SOUTH"

msgid "ГОЛУБОЙ"
msgstr "LIGHT BLUE"

msgid "ГОРНЫЙ ПЕРЕВАЛ"
msgstr "MOUNTAIN PASS"

msgid "ГОРОД"
msgstr "CITY"

msgid "ГОРОД ЖДЁТ ГЕРОЯ"
msgstr "THE CITY NEEDS A HERO"

msgid "ГОРОД ОГРОМНЫЙ. ВОЗЬМИ МАШИНУ: БАМПЕР — ТОЖЕ ОРУЖИЕ, А ДРИФТ НА ПЛОЩАДИ — ТОЖЕ ТАКТИКА."
msgstr "THE CITY IS HUGE. TAKE A CAR: THE BUMPER IS A WEAPON TOO, AND DRIFTING ON THE PLAZA IS A TACTIC TOO."

msgid "ГОРОДСКАЯ БОЛЬНИЦА"
msgstr "CITY HOSPITAL"

msgid "ГОРОДСКАЯ БОЛЬНИЦА №1"
msgstr "CITY HOSPITAL NO. 1"

msgid "ГОРОДСКАЯ БОЛЬНИЦА №1. НА ДВЕРЯХ ТАБЛИЧКА: «ПРИЁМ ПО ЗАПИСИ». НИЖЕ МАРКЕРОМ: «КУСАЮЩИХ НЕ ПРИНИМАЕМ»."
msgstr "CITY HOSPITAL NO. 1. A SIGN ON THE DOOR: \"APPOINTMENTS ONLY\". BELOW, IN MARKER: \"NO BITERS ALLOWED\"."

msgid "ГОША, ТЫ ГЕНИЙ!"
msgstr "GOSHA, YOU'RE A GENIUS!"

msgid "ГРАНАТА"
msgstr "GRENADE"

msgid "ГРАФИКА"
msgstr "GRAPHICS"

msgid "ГРАФИКА, УПРАВЛЕНИЕ"
msgstr "GRAPHICS, CONTROLS"

msgid "ГРАФИТ"
msgstr "GRAPHITE"

msgid "ГРОЗА МЕРТВЕЦОВ"
msgstr "BANE OF THE DEAD"

msgid "ГРОМИЛА"
msgstr "BRUTE"

msgid "ГРОМИЛА МЁРТВ, ГНЕЗДО ГОРИТ. В ПОДВАЛЕ ЦЕХА — ТРОЕ УЧЁНЫХ «ГЕНОМА». ОНИ ЗНАЮТ, КАК СДЕЛАТЬ ВАКЦИНУ."
msgstr "THE BRUTE IS DEAD, THE NEST IS BURNING. IN THE BASEMENT OF THE PLANT — THREE \"GENOME\" SCIENTISTS. THEY KNOW HOW TO MAKE A VACCINE."

msgid "ГРОМКОСТЬ"
msgstr "VOLUME"

msgid "ГРОМКОСТЬ ГОЛОСОВ"
msgstr "VOICE VOLUME"

msgid "ГРУЗОВИК"
msgstr "TRUCK"

msgid "ГРУЗЧИКИ ДНЯ НОЛЬ ТАК И ОСТАЛИСЬ НА СМЕНЕ. ИХ СОТНИ, И У НИХ ВСЁ ЕЩЁ КРЕПКИЕ РУКИ."
msgstr "THE DAY ZERO DOCKERS NEVER CLOCKED OUT. THERE ARE HUNDREDS OF THEM, AND THEIR GRIP IS STILL STRONG."

msgid "ГРУСТЯТ"
msgstr "SAD"

msgid "Город кишит мёртвыми. Пробейся к людям — убей 45 зомби, машина поможет"
msgstr "The city is crawling with the dead. Fight through to the people — kill 45 zombies, the car will help"

msgid "Грядки и теплица: +4 ящика провизии каждый день"
msgstr "Garden beds: +4 crates of food every day"

msgid "ДАВИЛКА"
msgstr "ROADKILL"

msgid "ДАЛЕЕ"
msgstr "NEXT"

msgid "ДАЛЕЕ  ▸"
msgstr "NEXT  ▸"

msgid "ДВЕ МИНУТЫ НА ПОЛИГОНЕ: ХОДЬБА, ОБЗОР, СТРЕЛЬБА, ПРИЦЕЛ И ПЕРВЫЕ ЗОМБИ. НАГРАДА — 150 МОНЕТ."
msgstr "TWO MINUTES ON THE PROVING GROUND: WALKING, LOOKING, SHOOTING, AIMING AND YOUR FIRST ZOMBIES. REWARD — 150 COINS."

msgid "ДВЕ НЕДЕЛИ БЫЛО ТИХО. ПОТОМ ЛЕВ ПОЙМАЛ ЮЖНЫЙ ПОРТ. ГОЛОС ЯКОРЕВА БЫЛ ХРИПЛЫМ. НО ЭТО УЖЕ ДРУГАЯ ИСТОРИЯ."
msgstr "IT WAS QUIET FOR TWO WEEKS. THEN LEV PICKED UP THE SOUTHERN PORT. YAKOREV'S VOICE WAS HOARSE. BUT THAT'S ANOTHER STORY."

msgid "ДВЕСТИ ЖИТЕЛЕЙ ПОРТА УСПЕЛИ УЙТИ В ГОРЫ И ЖДУТ ВАКЦИНУ. А «НАДЕЖДА» ЗАСТРЯЛА У ПРИЧАЛА: НИ ТОПЛИВА, НИ ДОРОГИ К НЕЙ."
msgstr "TWO HUNDRED PEOPLE FROM THE PORT ESCAPED INTO THE MOUNTAINS AND ARE WAITING FOR THE VACCINE. BUT THE NADEZHDA IS STUCK AT THE PIER: NO FUEL, NO WAY TO REACH HER."

msgid "ДВЕСТИ ПРИВИВОК. ТЁМА СДЕЛАЛ ИХ ВСЕ И НИ РАЗУ НЕ ПРОМАХНУЛСЯ. БАБА ШУРА ПОСТАВИЛА ЕМУ ПЯТЁРКУ — РУЧКОЙ, НА РУКЕ."
msgstr "TWO HUNDRED SHOTS. TYOMA GAVE EVERY ONE AND NEVER MISSED. GRANNY SHURA GAVE HIM AN A, IN PEN, ON HIS HAND."

msgid "ДВИГАЙСЯ: ВЕДИ ДЖОЙСТИК СЛЕВА"
msgstr "MOVE: DRAG THE JOYSTICK ON THE LEFT"

msgid "ДВИГАЙСЯ: КЛАВИШИ W A S D"
msgstr "MOVE: W A S D KEYS"

msgid "ДВИГАТЕЛЬ"
msgstr "ENGINE"

msgid "ДВИГАТЕЛЬ (скорость +8%)"
msgstr "ENGINE (speed +8%)"

msgid "ДВОЕ ЕГО ЛЮДЕЙ ОСТАЛИСЬ. СКАЗАЛИ, ЧТО У НАС КОРМЯТ ЛУЧШЕ И НИКТО НЕ ЗАСТАВЛЯЕТ НОСИТЬ КРАСНЫЕ ПЛАТКИ."
msgstr "TWO OF HIS MEN STAYED. THEY SAID THE FOOD IS BETTER HERE AND NOBODY MAKES THEM WEAR RED BANDANAS."

msgid "ДВОЕ ЕГО ПАРНЕЙ СДАЛИСЬ И ПОПРОСИЛИСЬ К НАМ. ГЕНКА ВЫДАЛ ИМ ФАРТУКИ. ПОСУДА В ЛАГЕРЕ НИКОГДА ЕЩЁ НЕ БЫЛА ТАКОЙ ЧИСТОЙ."
msgstr "TWO OF HIS GUYS SURRENDERED AND ASKED TO JOIN US. GENKA HANDED THEM APRONS. THE CAMP DISHES HAVE NEVER BEEN THIS CLEAN."

msgid "ДВОЙНЫЕ МОНЕТЫ"
msgstr "DOUBLE COINS"

msgid "ДВОР"
msgstr "YARD"

msgid "ДЕНИС"
msgstr "DENIS"

msgid "ДЕНИС И ЛЮБА ДВА ЧАСА СПОРИЛИ О ФРЕОНЕ. ТЁМА СКАЗАЛ, ЧТО ЭТО САМЫЙ РОМАНТИЧНЫЙ СПОР, КОТОРЫЙ ОН СЛЫШАЛ."
msgstr "DENIS AND LYUBA ARGUED ABOUT FREON FOR TWO HOURS. TYOMA SAID IT WAS THE MOST ROMANTIC ARGUMENT HE HAD EVER HEARD."

msgid "ДЕНИС РАСТАЩИТ ЗАВАЛ БРОНЕГРУЗОВИКОМ. ЭТО ГРОМКО И ДОЛГО. МЕРТВЕЦЫ ЛЮБЯТ И ТО, И ДРУГОЕ."
msgstr "DENIS WILL CLEAR THE PILE-UP WITH THE ARMORED TRUCK. IT IS LOUD AND IT TAKES TIME. THE DEAD LOVE BOTH."

msgid "ДЕНЬ 92. РАЦИЯ"
msgstr "DAY 92. THE RADIO"

msgid "ДЕНЬ 92. РАЦИЯ, КОТОРАЯ ТРИ МЕСЯЦА ШИПЕЛА, ВДРУГ ЗАГОВОРИЛА ЖЕНСКИМ ГОЛОСОМ: «МЫ НА СТОЯНКЕ У ТРАССЫ, НАС ДВОЕ, БРАТ РАНЕН!»"
msgstr "DAY 92. THE RADIO THAT HAD HISSED FOR THREE MONTHS SUDDENLY SPOKE IN A WOMAN'S VOICE: \"WE'RE AT THE YARD BY THE HIGHWAY, THERE'S TWO OF US, MY BROTHER'S HURT!\""

msgid "ДЕНЬ МАРОДЁРА"
msgstr "LOOTER'S DAY"

msgid "ДЕНЬ НОЛЬ"
msgstr "DAY ZERO"

msgid "ДЕНЬ НОЛЬ, 18:40. ПОЖАР В «ГЕНОМЕ». ЧЕРЕЗ ЧАС ПО ГОРОДУ БЕЖАЛИ ЛЮДИ. ЧЕРЕЗ ДВА — ЗА НИМИ БЕЖАЛИ ТЕ, КТО УЖЕ НЕ БЫЛ ЛЮДЬМИ."
msgstr "DAY ZERO, 18:40. A FIRE AT \"GENOME\". AN HOUR LATER PEOPLE WERE RUNNING THROUGH THE CITY. TWO HOURS LATER THEY WERE BEING CHASED BY THOSE WHO WERE NO LONGER PEOPLE."

msgid "ДЕРЖИ ВОРОТА. ТЁМА НА КРЫШЕ С РАЦИЕЙ, ДЕНИС ЗАВАРИВАЕТ ДЫРЫ В ЗАБОРЕ, А ГЕНКА — БЫВШИЙ БАРОН — ВПЕРВЫЕ В ЖИЗНИ ОХРАНЯЕТ ТО, ЧТО НЕ УКРАЛ."
msgstr "HOLD THE GATE. TYOMA IS ON THE ROOF WITH THE RADIO, DENIS IS WELDING HOLES IN THE FENCE, AND GENKA, THE FORMER BARON, IS GUARDING SOMETHING HE DIDN'T STEAL FOR THE FIRST TIME IN HIS LIFE."

msgid "ДЕРЖИ ПОДЪЕЗД К МОСТУ. ГНОМОВ ДЕНИС ОБЕЩАЛ СОХРАНИТЬ — ТЁМА ПОТРЕБОВАЛ."
msgstr "HOLD THE APPROACH TO THE BRIDGE. DENIS PROMISED TO SAVE THE GNOMES: TYOMA DEMANDED IT."

msgid "ДЕРЖИ ПРИЧАЛ, ПОКА ВСЕ НЕ ПОДНИМУТСЯ НА БОРТ. ПЯТЬ ВОЛН — И УТОПЛЕННИК. ПРАВИЛО №1 ТЕПЕРЬ ЗВУЧИТ ТАК: ПРОВЕРЯЙ ЗАДНЮЮ ПАЛУБУ."
msgstr "HOLD THE PIER UNTIL EVERYONE IS ABOARD. FIVE WAVES, THEN THE DROWNED ONE. RULE NO. 1 NOW GOES LIKE THIS: ALWAYS CHECK THE BACK DECK."

msgid "ДЖОЙСТИК\n(ПЕРЕТАЩИ НА ДРУГУЮ СТОРОНУ)"
msgstr "JOYSTICK\n(DRAG TO THE OTHER SIDE)"

msgid "ДИДЖЕЙ"
msgstr "DJ"

msgid "ДИСПЕТЧЕР"
msgstr "DISPATCHER"

msgid "ДИСТАНЦИЯ КАМЕРЫ (3-Е ЛИЦО)"
msgstr "CAMERA DISTANCE (3RD PERSON)"

msgid "ДЛЯ МАСТЕРСКОЙ"
msgstr "FOR THE WORKSHOP"

msgid "ДО ВСЕГО ЭТОГО"
msgstr "BEFORE ALL THIS"

msgid "ДО КОРАБЛЯ ДВА ДНЯ. А СТАРЫЙ МОСТ ЗАБИТ МАШИНАМИ ДНЯ НОЛЬ: АВТОБУС, ДВА ГРУЗОВИКА И ЧЕЙ-ТО ДОМ НА КОЛЁСАХ С ГНОМАМИ НА КРЫШЕ."
msgstr "TWO DAYS UNTIL THE SHIP. AND THE OLD BRIDGE IS JAMMED WITH CARS FROM DAY ZERO: A BUS, TWO TRUCKS AND SOMEONE'S MOTORHOME WITH GARDEN GNOMES ON THE ROOF."

msgid "ДО ПОРТА — КИЛОМЕТР ПОРТОВЫХ СКЛАДОВ. МИХАЛЫЧ ЗНАЕТ ИХ НАИЗУСТЬ: «ТУТ ВОДКА, ТУТ ЗАПЧАСТИ, ТУТ БАНАНЫ. БЫЛИ»."
msgstr "A KILOMETER OF PORT WAREHOUSES STANDS BETWEEN US AND THE PORT. MIKHALYCH KNOWS THEM BY HEART: \"VODKA HERE, SPARE PARTS HERE, BANANAS HERE. USED TO BE.\""

msgid "ДОБАВКИ МОЖНО?"
msgstr "CAN I HAVE SECONDS?"

msgid "ДОВОЛЬНЫ"
msgstr "CONTENT"

msgid "ДОКТОР ИРИНА СОБИРАЕТ ВАКЦИНУ ИЗ ТОГО, ЧТО ЕСТЬ: МИКРОСКОП ТЁМЫ, ХОЛОДИЛЬНИК ДЕНИСА И КОФЕМАШИНА ДЯДИ ГОШИ — «ДЛЯ НАСТРОЕНИЯ»."
msgstr "DOCTOR IRINA IS BUILDING A VACCINE FROM WHAT WE'VE GOT: TYOMA'S MICROSCOPE, DENIS'S FRIDGE AND UNCLE GOSHA'S COFFEE MACHINE — \"FOR MORALE\"."

msgid "ДОМОЙ"
msgstr "HOMEWARD"

msgid "ДОРОГА НА ЮГ"
msgstr "ROAD TO THE SOUTH"

msgid "ДОРОГА ЧИСТА. НА МОСТУ ОСТАЛСЯ ТОЛЬКО МАМИН СИНИЙ ШАРФ НА ПЕРИЛАХ. МЫ ЕГО НЕ ТРОГАЛИ."
msgstr "THE ROAD IS CLEAR. ONLY MOM'S BLUE SCARF REMAINS ON THE BRIDGE RAILING. WE LEFT IT ALONE."

msgid "ДОСТИЖЕНИЕ!"
msgstr "ACHIEVEMENT!"

msgid "ДОСТИЖЕНИЯ"
msgstr "ACHIEVEMENTS"

msgid "ДОСТУПНА"
msgstr "AVAILABLE"

msgid "ДРИФТ"
msgstr "DRIFT"

msgid "ДРИФТ  %d"
msgstr "DRIFT  %d"

msgid "ДРИФТ  %d  +%s"
msgstr "DRIFT  %d  +%s"

msgid "ДРИФТ-ПЛОЩАДЬ"
msgstr "DRIFT PLAZA"

msgid "ДРОБОВИК"
msgstr "SHOTGUN"

msgid "ДУЛО"
msgstr "MUZZLE"

msgid "ДЯДЯ ГОША"
msgstr "UNCLE GOSHA"

msgid "ДЯДЯ ГОША ОТКРЫЛ В ЛАГЕРЕ КОФЕЙНЮ «ПОСЛЕДНЯЯ КАПЛЯ». ШНЫРЬ ВЕДЁТ БУХГАЛТЕРИЮ НА СОВЕТСКОМ КАЛЬКУЛЯТОРЕ И НОСИТ БОРОДУ С ГОРДОСТЬЮ."
msgstr "UNCLE GOSHA OPENED A COFFEE SHOP IN THE CAMP: \"THE LAST DROP\". SHNYR KEEPS THE BOOKS ON A SOVIET CALCULATOR AND WEARS HIS BEARD WITH PRIDE."

msgid "ДЯДЯ ГОША, А ЧТО НА ОБЕД? «НИЧЕГО»? ОПЯТЬ?"
msgstr "UNCLE GOSHA, WHAT'S FOR LUNCH? \"NOTHING\"? AGAIN?"

msgid "Два автомата из торгового центра. Рекорд у Тёмы"
msgstr "Two cabinets from the mall. Tyoma holds the high score"

msgid "Два шезлонга у зоны отдыха — загорать под вой зомби"
msgstr "Two loungers by the lounge — sunbathe to the zombie howls"

msgid "Две волны зомби, в последней — огромный босс. Уворачивайся от рывка и удара о землю"
msgstr "Two waves of zombies, the last one with a huge boss. Dodge his charge and ground slam"

msgid "Двести человек получают прививку, а орда идёт на вой к воротам деревни. Удержи ворота 120 секунд"
msgstr "Two hundred people are getting vaccinated while the horde follows the howl to the village gate. Hold the gate for 120 seconds"

msgid "Двор больше: %d × %d м."
msgstr "Bigger yard: %d × %d m."

msgid "Двор ещё шире: столовая, кинотеатр и ветряк"
msgstr "An even wider yard: canteen, cinema and a wind turbine"

msgid "Двор из контейнеров, костёр и пара палаток"
msgstr "A container yard, a campfire and a couple of tents"

msgid "День серии: %d из %d. Заходи каждый день — награда растёт"
msgstr "Streak day: %d of %d. Come back daily — the reward grows"

msgid "Держись как можно дольше: волны без конца"
msgstr "Hold out as long as you can: endless waves"

msgid "Для вакцины нужны реактивы с аптечного склада у проспекта. Собери 6 ящиков, пока их не нашли плевуны"
msgstr "The vaccine needs reagents from the pharmacy warehouse by the avenue. Collect 6 crates before the spitters find them"

msgid "Для детей и для дяди Гоши. Скрипят на весь двор"
msgstr "For the kids and for uncle Gosha. They squeak across the yard"

msgid "Доедь до финиша заезда"
msgstr "Finish a race"

msgid "Дорога в порт идёт через склады, забитые мертвецами. Пробейся: убей 45 зомби"
msgstr "The road to the port runs through warehouses packed with the dead. Break through: kill 45 zombies"

msgid "Дядя Гоша гремит пустой кастрюлей. Пора на обед — и за наградой дня!"
msgstr "Uncle Gosha is banging an empty pot. Lunch time — and grab your daily reward!"

msgid "ЕЖЕДНЕВНАЯ НАГРАДА ГОТОВА"
msgstr "DAILY REWARD IS READY"

msgid "ЕЖЕДНЕВНО"
msgstr "DAILY"

msgid "ЕЖЕДНЕВНО  !"
msgstr "DAILY  !"

msgid "ЕСЛИ НЕ ПООБЕДАЕМ, Я СЪЕМ ДИВАН."
msgstr "IF WE DON'T EAT SOON, I'LL EAT THE COUCH."

msgid "ЕСТЬ"
msgstr "OWNED"

msgid "ЕСТЬ ХОЧЕТСЯ… ДАЖЕ ЗОМБИ ПАХНУТ КОТЛЕТОЙ."
msgstr "SO HUNGRY… EVEN ZOMBIES SMELL LIKE MEATBALLS."

msgid "ЕЩЁ РАЗ"
msgstr "AGAIN"

msgid "ЖЁЛТЫЙ"
msgstr "YELLOW"

msgid "ЖДЁМ ИГРОКОВ…"
msgstr "WAITING FOR PLAYERS…"

msgid "ЖДЁМ ИГРОКОВ…  %d"
msgstr "WAITING FOR PLAYERS…  %d"

msgid "ЖДЁМ, КОГДА ХОСТ НАЖМЁТ СТАРТ…"
msgstr "WAITING FOR THE HOST TO PRESS START…"

msgid "ЖИЗНЬ НАЛАЖИВАЕТСЯ!"
msgstr "LIFE IS GETTING BETTER!"

msgid "ЖИЛЬЦЫ ПРОГОЛОДАЛИСЬ"
msgstr "THE RESIDENTS ARE HUNGRY"

msgid "ЖИЛЬЦЫ: %d / %d МЕСТ"
msgstr "RESIDENTS: %d / %d BEDS"

msgid "Жильцы заработали монеты. Забери, пока дядя Гоша не купил ещё одну кофемашину!"
msgstr "The residents earned coins. Grab them before uncle Gosha buys another coffee machine!"

msgid "Жильцы работают: монеты копятся до %d ч. Больше людей и выше настроение — больше доход"
msgstr "Residents work: coins pile up for up to %d h. More people and better mood — more income"

msgid "ЗА ПЕРЕВАЛОМ ПОКАЗАЛАСЬ ДЕРЕВНЯ ВЕРХНИЕ КЛЮЧИ: ЧАСТОКОЛ, ДЫМ ИЗ ТРУБ И ЛЮДИ НА СТЕНЕ. ОНИ МАХАЛИ НАМ ВСЕМИ РУКАМИ."
msgstr "BEYOND THE PASS WE SAW THE VILLAGE OF UPPER SPRINGS: A STOCKADE, SMOKE FROM CHIMNEYS AND PEOPLE ON THE WALL. THEY WAVED AT US WITH BOTH HANDS."

msgid "ЗА РЕКОЙ РАБОТАЛА ЛАБОРАТОРИЯ «ГЕНОМ». ОНИ ИСКАЛИ ЛЕКАРСТВО ОТ СТАРОСТИ — И НАШЛИ «ГНИЛЬ-7». ОНА НЕ ЛЕЧИЛА СТАРОСТЬ. ОНА ОТМЕНЯЛА СМЕРТЬ."
msgstr "ACROSS THE RIVER STOOD THE \"GENOME\" LAB. THEY WERE LOOKING FOR A CURE FOR OLD AGE — AND FOUND \"ROT-7\". IT DIDN'T CURE OLD AGE. IT CANCELED DEATH."

msgid "ЗА РУЛЬ"
msgstr "DRIVE"

msgid "ЗА ТРАССОЙ"
msgstr "PAST THE HIGHWAY"

msgid "ЗА ТРИ ДНЯ ДО КОРАБЛЯ"
msgstr "THREE DAYS BEFORE THE SHIP"

msgid "ЗА ТРИ ДНЯ ДО КОРАБЛЯ ИЗ ЛАБОРАТОРИИ ПРОПАЛ ЧЕМОДАН С ВАКЦИНОЙ. И ШНЫРЬ. И ЕГО БОРОДА."
msgstr "THREE DAYS BEFORE THE SHIP, THE CASE WITH THE VACCINE VANISHED FROM THE LAB. SO DID SHNYR. AND HIS BEARD."

msgid "ЗАБРАТЬ"
msgstr "CLAIM"

msgid "ЗАБРАТЬ %s"
msgstr "CLAIM %s"

msgid "ЗАБРАТЬ +%d"
msgstr "COLLECT +%d"

msgid "ЗАВОДСКОЙ"
msgstr "FACTORY"

msgid "ЗАВТРА — МОСТ"
msgstr "TOMORROW — THE BRIDGE"

msgid "ЗАГРУЗИТЬ"
msgstr "LOAD"

msgid "ЗАГРУЗИТЬ КОД МОЖНО ТОЛЬКО В УБЕЖИЩЕ"
msgstr "A CODE CAN ONLY BE LOADED IN THE SHELTER"

msgid "ЗАГРУЗИТЬ ПРОГРЕСС ИЗ КОДА"
msgstr "LOAD PROGRESS FROM A CODE"

msgid "ЗАГРУЗКА  %d%%"
msgstr "LOADING  %d%%"

msgid "ЗАГРУЗКА КАРТЫ…"
msgstr "LOADING MAP…"

