msgid "УДЕРЖИ ВЫШКУ, ПОКА ИДЁТ ПЕРЕДАЧА. ЗОМБИ ИДУТ НА ЗВУК, СОБАКИ — НА ЗАПАХ, А ЛЕВ РУГАЕТСЯ НА ПОМЕХИ."
msgstr "HOLD THE TOWER WHILE THE TRANSMISSION RUNS. ZOMBIES FOLLOW THE SOUND, DOGS FOLLOW THE SMELL, AND LEV CURSES AT THE STATIC."

msgid "УДЕРЖИ ТОЧКУ, ПОКА ОНИ ЗАЛИВАЮТ БОЧКИ. СТЕРВЯТНИКИ ТОЖЕ ХОТЯТ ТОПЛИВО. И ВЗРЫВНЫЕ ЗОМБИ ХОТЯТ… ПРОСТО ВЗОРВАТЬСЯ."
msgstr "HOLD THE POINT WHILE THEY FILL THE BARRELS. THE VULTURES WANT FUEL TOO. AND THE EXPLODERS WANT… JUST TO EXPLODE."

