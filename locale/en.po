msgstr "The bus is stuck in the snow on the pass. Hold out for 2.5 minutes while Tyoma fixes it"

msgid "БАБА ШУРА"
msgstr "GRANNY SHURA"

msgid "БАЗА"
msgstr "BASE"

msgid "БАЗА КАБАНА"
msgstr "KABAN'S BASE"

msgid "БАКИ ПУСТЫ. ТОПЛИВО — В КАНИСТРАХ ПО ВСЕМУ ПОРТУ: НА ПИРСЕ, У МАЯКА, МЕЖДУ КОНТЕЙНЕРАМИ. МЕРТВЕЦЫ ИДУТ НА ЗАПАХ СОЛЯРКИ — НЕ СПРАШИВАЙ ПОЧЕМУ."
msgstr "THE TANKS ARE EMPTY. THE FUEL IS IN CANS ALL OVER THE PORT: ON THE PIER, BY THE LIGHTHOUSE, BETWEEN THE CONTAINERS. THE DEAD FOLLOW THE SMELL OF DIESEL. DON'T ASK WHY."

msgid "БАНДИТ"
msgstr "BANDIT"

msgid "БАНДИТ С ОБРЕЗОМ"
msgstr "SAWED-OFF BANDIT"

msgid "БАНДИТЫ НЕ ЗОМБИ: ОНИ СТРЕЛЯЮТ, ПРЯЧУТСЯ И ОРУТ ГЛУПОСТИ. ЗАТО ИХ МОЖНО ДОПРОСИТЬ."
msgstr "BANDITS AREN'T ZOMBIES: THEY SHOOT, TAKE COVER AND YELL NONSENSE. ON THE PLUS SIDE, YOU CAN INTERROGATE THEM."

msgid "БАРНАЯ СТОЙКА"
msgstr "BAR COUNTER"

msgid "БАРОН"
msgstr "BARON"

msgid "БАРОН СДАЛСЯ. БЕЗ АВТОМАТА И ПЛАЩА ОН ОКАЗАЛСЯ ОБЫЧНЫМ ГЕНКОЙ, КОТОРЫЙ ОЧЕНЬ БОИТСЯ ДЯДЮ ГОШУ."
msgstr "BARON SURRENDERED. WITHOUT HIS RIFLE AND CLOAK HE TURNED OUT TO BE JUST GENKA, WHO IS VERY SCARED OF UNCLE GOSHA."

msgid "БАРОН ХВАСТАЛСЯ МАЛЬЧИШКОЙ, КОТОРЫЙ ЧИНИТ ЛЮБУЮ РАЦИЮ. «ЕСТ ЗА ТРОИХ, ВСЕХ БЕСИТ, НО РУКИ ЗОЛОТЫЕ». ЭТО ТЁМА. ТОЧНО ТЁМА."
msgstr "BARON BRAGGED ABOUT A KID WHO CAN FIX ANY RADIO. \"EATS FOR THREE, ANNOYS EVERYONE, BUT HE'S GOT GOLDEN HANDS.\" THAT'S TYOMA. IT HAS TO BE TYOMA."

msgid "БАСКЕТБОЛ"
