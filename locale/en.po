msgstr "GOAL: %s"

msgid "ЦЕНТР ГОРОДА. ГОД НАЗАД"
msgstr "CITY CENTER. A YEAR AGO"

msgid "ЦЕНТР ГОРОДА. ЗДЕСЬ БЫЛИ ФОНТАН, КИНО И САМЫЙ ВКУСНЫЙ ШАУРМИСТ ОБЛАСТИ. ФОНТАН НА МЕСТЕ."
