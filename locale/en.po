msgid "ВЕТЕРАН"
msgstr "VETERAN"

msgid "ВЕТРЯК"
msgstr "WIND TURBINE"

msgid "ВЕЧНАЯ ОБОРОНА"
msgstr "ETERNAL DEFENSE"

msgid "ВЗРЫВНАЯ НЕДЕЛЯ"
