msgid "БОРЩОВ СДЕРЖАЛ СЛОВО: БОРЩ БЫЛ ИЗ КОНСЕРВОВ, НО ГОРЯЧИЙ. ТЁМА СЪЕЛ ДВЕ ТАРЕЛКИ И ПОТРЕБОВАЛ ТРЕТЬЮ «ЗА ПЕРЕГОВОРЫ»."
msgstr "BORSHCHOV KEPT HIS WORD: THE BORSCHT CAME FROM CANS, BUT IT WAS HOT. TYOMA ATE TWO BOWLS AND DEMANDED A THIRD \"FOR THE NEGOTIATIONS\"."

msgid "БОСС"
