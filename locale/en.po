msgid "БОССОВ ПОБЕЖДЕНО"
msgstr "BOSSES DEFEATED"

msgid "БОЧКИ С КРАСНОЙ ПОЛОСОЙ ВЗРЫВАЮТСЯ. ИСПОЛЬЗУЙ ЭТО. ГЛАВНОЕ — НЕ СТОЙ РЯДОМ."
msgstr "BARRELS WITH A RED STRIPE EXPLODE. USE THAT. JUST DON'T STAND NEXT TO THEM."

msgid "БРОНЕГРУЗОВИК"
