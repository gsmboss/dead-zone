msgid "YOUTUBE, INSTAGRAM И TELEGRAM SALAMANDERLAB: НОВОСТИ, ТРЕЙЛЕРЫ И КОДЫ. ЗА ПОДПИСКИ — %s."
msgstr "SALAMANDERLAB ON YOUTUBE, INSTAGRAM AND TELEGRAM: NEWS, TRAILERS AND CODES. FOLLOW AND GET %s."

msgid "x2 МОНЕТЫ  ▶ РЕКЛАМА"
msgstr "x2 COINS  ▶ AD"

msgid "«ЗОМБИ? — ПЕРЕСПРОСИЛ ПАЛЫЧ. — А Я ДУМАЛ, ГРУЗЧИКИ БЕЗ ЗАРПЛАТЫ». ГЕНЕРАТОР МАЯКА ЗАВЕДЁТСЯ, НО РЕВЁТ ТАК, ЧТО ЕГО СЛЫШНО НА ТОМ СВЕТЕ."
msgstr "\"ZOMBIES?\" PALYCH ASKED. \"I THOUGHT THEY WERE DOCKERS WHO NEVER GOT PAID.\" THE LIGHTHOUSE GENERATOR WILL START, BUT IT ROARS LOUD ENOUGH TO BE HEARD IN THE AFTERLIFE."

msgid "«К ТОЧКЕ ДОСТУПА» ИЛИ ВВОДЯТ IP ХОСТА. ДО 4 ИГРОКОВ."
msgstr "\"TO HOTSPOT\" OR ENTER THE HOST IP. UP TO 4 PLAYERS."

msgid "«НАДЕЖДА» ВСТАЛА В БУХТЕ У КУРОРТА «ЧАЙКА». ДО ГОР, ГДЕ ЖДУТ ДВЕСТИ ЧЕЛОВЕК, — ДВА ДНЯ ПО СЕРПАНТИНУ. КОРАБЛЬ ТУДА НЕ ДОПЛЫВЁТ."
msgstr "THE NADEZHDA ANCHORED IN THE BAY BY THE SEAGULL RESORT. TO THE MOUNTAINS WHERE TWO HUNDRED PEOPLE WAIT IS TWO DAYS OF SWITCHBACKS. THE SHIP CAN'T GO THERE."

msgid "«НАДЕЖДА» ДОВЕЗЛА ВАКЦИНУ ДО ЛЮДЕЙ В ГОРАХ. ЧЕРЕЗ МЕСЯЦ ЛЕВ ПОЙМАЛ ГОЛОСА ЕЩЁ ТРЁХ ГОРОДОВ: ТАМ ТОЖЕ ЖИВУТ."
msgstr "THE NADEZHDA DELIVERED THE VACCINE TO THE PEOPLE IN THE MOUNTAINS. A MONTH LATER LEV PICKED UP VOICES FROM THREE MORE CITIES: PEOPLE LIVE THERE TOO."

msgid "«НАДЕЖДА» ШЛА ДОМОЙ НА ВСЕХ ПАРАХ. БОРЩОВ ВАРИЛ БОРЩ ДЛЯ ВСЕХ, ЭДИК УЧИЛ ДЕРЕВЕНСКИХ ТАНЦЕВАТЬ, ТЁМА СПАЛ НА МЕШКЕ С КАРТОШКОЙ."
msgstr "THE NADEZHDA RACED HOME AT FULL STEAM. BORSHCHOV COOKED BORSCHT FOR EVERYONE, EDIK TAUGHT THE VILLAGERS TO DANCE, TYOMA SLEPT ON A SACK OF POTATOES."

msgid "«Я ЖИВ. ИДУ К ЛЕСУ. Т.»"
msgstr "\"I'M ALIVE. HEADING TO THE FOREST. T.\""

msgid "ЁЛКА"
msgstr "CHRISTMAS TREE"

msgid "Ёлка с огоньками и подарками — Новый год по своему календарю"
msgstr "A tree with lights and presents — New Year on our own calendar"

msgid "А В АРХИВЕ ВЫШКИ ЛЕВ НАШЁЛ ЗАПИСЬ ДНЯ НОЛЬ. ЖЕНСКИЙ ГОЛОС НА АВАРИЙНОЙ ЧАСТОТЕ: «ЕСЛИ КТО-ТО НАЙДЁТ МОИХ МАЛЬЧИКОВ…» ЭТО МАМА."
msgstr "AND IN THE TOWER ARCHIVE LEV FOUND A RECORDING FROM DAY ZERO. A WOMAN'S VOICE ON THE EMERGENCY FREQUENCY: \"IF ANYONE FINDS MY BOYS…\" IT'S MOM."

msgid "А ВЫШЕ, В ГОРАХ, КТО-ТО ВЫЛ. ДОЛГО И НИЗКО. МЕРТВЕЦЫ НА СКЛОНАХ ПОВЕРНУЛИ ГОЛОВЫ НА ЗВУК — РАЗОМ, КАК СТАДО."
msgstr "AND HIGHER UP, IN THE MOUNTAINS, SOMETHING HOWLED. LONG AND LOW. THE DEAD ON THE SLOPES TURNED THEIR HEADS TO THE SOUND, ALL AT ONCE, LIKE A HERD."

msgid "А ПОТОМ ЛУЧ ВЫХВАТИЛ ИЗ ВОДЫ ЧТО-ТО ОГРОМНОЕ. ОНО СТОЯЛО ПО ПОЯС В МОРЕ И СМОТРЕЛО НА МАЯК. ПАЛЫЧ СКАЗАЛ, ЧТО ЭТО ГРУЗЧИК. ЯКОРЕВ СКАЗАЛ: «УТОПЛЕННИК»."
msgstr "THEN THE BEAM CAUGHT SOMETHING HUGE IN THE WATER. IT STOOD WAIST-DEEP IN THE SEA, STARING AT THE LIGHTHOUSE. PALYCH SAID IT WAS A DOCKER. YAKOREV SAID: \"THE DROWNED ONE.\""

msgid "А ПОТОМ ОН УСЛЫШАЛ ГОЛОС БАРОНА ПО РАЦИИ И ЗАХОХОТАЛ: «ДА ЭТО ЖЕ ГЕНКА! ОХРАННИК ИЗ УНИВЕРМАГА! ОН НА ПАРКОВКЕ ШТРАФЫ ВЫПИСЫВАЛ!»"
msgstr "THEN HE HEARD BARON'S VOICE ON THE RADIO AND BURST OUT LAUGHING: \"THAT'S GENKA! THE SECURITY GUARD FROM THE DEPARTMENT STORE! HE USED TO WRITE PARKING TICKETS!\""

msgid "АВТО"
msgstr "AUTO"

