msgid "ВСЕ ВОСЕМЬ В ЛАГЕРЕ. ДЯДЯ ГОША ВАРИЛ КОФЕ ПРЯМО В КУЗОВЕ, НА ХОДУ. НИКТО НЕ ОБЖЁГСЯ. ПОЧТИ."
